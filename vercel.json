{
  "redirects": [
    {
      "source": "/image-generator",
      "destination": "/workspace/image-generator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/send-abandoned-emails",
      "schedule": "*/10 * * * *"
    }
  ]
}