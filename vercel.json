{
  "redirects": [
    {
      "source": "/image-generator",
      "destination": "/workspace/image-generator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/send-abandoned-emails",
      "schedule": "0 * * * *"
    }
  ]
}