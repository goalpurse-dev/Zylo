us":["returnPipe","tank","arch"],"width":1}]},{"s":"myth","shows":{"p":"wasteWater","does":"hose floods the floor, the wrong idea"},"do":[{"p":"arch","v":"stopSpray","w":"And"},{"p":"wasteWater","v":"flood","w":"waste"},{"p":"hoseSpray","v":"start","w":"hose"}],"shots":[{"focus":["car","wasteWater"],"type":"mid"}]},{"s":"mythFact","shows":{"p":"arch","does":"arch sprays little fresh water while the hose runs"},"do":[{"p":"wasteWater","v":"hide","w":"It"},{"p":"arch","v":"spray","w":"uses"},{"p":"arch","v":"rinse","w":"fresh"}],"shots":[{"focus":["arch","tank","hoseSpray"],"width":1}]},{"s":"finish","shows":{"p":"canopy","does":"kiosk, vacuum and canopy are added"},"do":[{"p":"hoseSpray","v":"stop","w":"Add"},{"p":"arch","v":"stopSpray","w":"Add"},{"p":"arch","v":"open","w":"Add"},{"p":"returnFlow","v":"hide","w":"Add"},{"p":"outFlow","v":"hide","w":"Add"},{"p":"dig","v":"refill","w":"Add"},{"p":"kiosk","v":"show","w":"kiosk"},{"p":"vacuum","v":"show","w":"vacuum"},{"p":"canopy","v":"build","w":"canopy"}],"shots":[{"focus":"home"}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"audio":{"cards":[{"text":"80 PERCENT","at":{"s":"fact","w":"80"},"d":1.6},{"text":"15 GALLONS","at":{"s":"mythFact","w":"15"},"d":1.6},{"text":"140 GALLONS","at":{"s":"mythFact","w":"140"},"d":1.6}],"sfx":[{"lib":"water_rush","at":{"s":"hook","w":"hose","o":0.4},"d":1.2},{"lib":"motor_hum","at":{"s":"fix1","w":"strips"},"d":1.5},{"lib":"water_rush","at":{"s":"problem2","w":"runs"},"d":1.3},{"lib":"dirt","at":{"s":"fix2","w":"cut","o":0.05},"d":1.2},{"lib":"drip","at":{"s":"how","w":"sinks"},"d":1.3},{"lib":"motor_hum","at":{"s":"fact","w":"sends"},"d":2}],"chimes":[{"s":"name"},{"s":"fact","w":"80"},{"s":"mythFact","w":"15"},{"s":"mythFact","w":"140"},{"s":"congrats"}]},"why":"A car wash in section: the car arrives, a hose smears mud, an arch with soap and cloth strips fixes it, and a floor drain leads to an underground reclaim tank where sand sinks and oil rises. A pump returns the water to the arch, and the myth is shown with a hose flooding the floor. I changed the two props to the allowed types kiosk and vacuum, ended the waste-water fill at the face, and re-aimed or tightened the shots so they hold the cut."},"sentences":[{"role":"hook","text":"If you spray a muddy car with a hose, you have a car wash."},{"role":"problem","text":"But the mud just smears on the paint."},{"role":"fix1","text":"So you build an arch with soap sprays and cloth strips."},{"role":"problem2","text":"But the soapy water runs into the creek."},{"role":"fix2","text":"So you cut a floor drain into an underground tank."},{"role":"name","text":"This is a water reclaim tank."},{"role":"how","text":"Sand sinks, oil rises, and clean water goes to a pump."},{"role":"fact","text":"That pump sends up to 80 percent of the water back to the arch."},{"role":"myth","text":"And a car wash does not waste more water than a hose."},{"role":"mythFact","text":"It uses about 15 gallons of fresh water a car, but a hose can use up to 140."},{"role":"finish","text":"Add a pay kiosk, a vacuum station, and a canopy."},{"role":"congrats","text":"Congratulations, you have built a car wash."}]}