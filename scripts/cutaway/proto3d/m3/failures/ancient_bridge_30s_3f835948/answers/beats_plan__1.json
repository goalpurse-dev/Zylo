     "size": 4
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "a dark crack opens across a flat stone slab laid over the pier",
     "stakes": "the whole span could collapse under the next cart",
     "size": 7
    }
   ],
   "surprises": [
