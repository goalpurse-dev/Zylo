  "story": {
   "title": "How an ancient arch bridge works",
   "hero": "an arch bridge",
   "parts": [
    "plank",
    "cart",
    "stone pier",
    "stone slab",
    "wooden frame",
    "wedge stones",
    "keystone",
    "brick arch",
    "road",
    "low walls"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "dig a channel, fill it with water and lay one plank across: the simplest bridge"
    },
    {
     "role": "fix1",
     "idea": "stone piers stand in the river and flat slabs rest on top, so the span is strong and does not snap"
    },
    {
     "role": "problem",
     "idea": "a cart loaded with stone is too heavy for the plank, which snaps and drops it toward the water"
    },
    {
     "role": "problem2",
     "idea": "a long flat slab is weak when stretched underneath, so a crack opens in its middle"
    },
    {
     "role": "fix2",
     "idea": "a wooden frame holds wedge stones in a curve until the keystone locks the top"
    },
    {
     "role": "name",
     "idea": "the finished curve of stones is an arch bridge"
    },
    {
     "role": "how",
     "idea": "the weight squeezes the stones along the curve down into the piers, which is why old arches still stand"
    },
    {
     "role": "fix3",
     "idea": "the wooden frame is pulled away and the arch holds itself, with no glue"
    },
    {
     "role": "myth",
     "idea": "a Roman flag appears and is crossed out: the Romans did not invent the arch"
    },
    {
     "role": "mythFact",
     "idea": "Mesopotamian builders raised brick arches over 4000 years ago, as a small mud-brick arch shows"
    },
    {
     "role": "finish",
     "idea": "a stone road and low walls go on top, and a cart rolls across"
    },
    {
     "role": "congrats",
     "idea": "the arch bridge is done and calm, the cart has crossed"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "a cart loaded with stone rolls onto the plank, which snaps and tilts into the channel",
