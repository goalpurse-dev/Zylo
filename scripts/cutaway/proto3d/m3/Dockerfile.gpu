# M3: the Cutaway render worker. One image for both renderers:
#  - RunPod serverless GPU (the default CMD: handler.py; WebGL on the NVIDIA GPU through ANGLE-on-EGL), and
#  - the Fly CPU fallback (CMD overridden: node .../m3/worker.mjs, mode "cpu", SwiftShader).
# The build context is assembled by m3/buildContext.mjs (proto = the render folder's packages and R1 textures,
# wt = the kit, the M2 code and the final-mix modules, fonts = the caption font).
FROM node:22-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_DRIVER_CAPABILITIES=all \
    NVIDIA_VISIBLE_DEVICES=all \
    CHROME_PATH=/usr/bin/google-chrome \
    CUTAWAY_WT=/app/wt \
    CUTAWAY_PROTO=/app/proto \
    CUTAWAY_FONTS=/app/fonts

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg libvulkan1 libegl1 libgl1 libgles2 ca-certificates wget python3 python3-pip \
 && wget -q https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -O /tmp/chrome.deb \
 && apt-get install -y --no-install-recommends /tmp/chrome.deb \
 && rm -f /tmp/chrome.deb && rm -rf /var/lib/apt/lists/*

# the NVIDIA vendor files: the container gets the driver's libraries but often not these, and without them every
# loader falls back to software rendering
RUN mkdir -p /usr/share/glvnd/egl_vendor.d /etc/vulkan/icd.d \
 && echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0"}}' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
 && echo '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3"}}' > /etc/vulkan/icd.d/nvidia_icd.json

RUN pip3 install --no-cache-dir --break-system-packages "runpod>=1.7,<2"

WORKDIR /app/proto
COPY proto/package.json proto/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY proto/assets ./assets
COPY wt /app/wt
COPY fonts /app/fonts
COPY handler.py /app/handler.py

CMD ["python3", "-u", "/app/handler.py"]
