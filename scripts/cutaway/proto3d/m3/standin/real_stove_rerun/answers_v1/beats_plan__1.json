   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "let gas out of a pipe and light it and you already have a stove"
    },
    {
     "role": "problem",
     "idea": "the lazy yellow flame is full of unburnt soot that pours off it"
    },
    {
     "role": "fix1",
     "idea": "a burner tube with air holes mixes air in, so the flame burns clean and blue"
    },
    {
     "role": "name",
     "idea": "that tube with air holes is a Bunsen burner"
    },
    {
     "role": "how",
     "idea": "the gas jet pulls in about half the air it needs through the holes"
    },
    {
     "role": "problem2",
     "idea": "a draft blows the flame out and the gas keeps drifting into the room"
    },
    {
     "role": "fix2",
     "idea": "a thermocouple in the flame holds a safety valve open and lets it shut when the flame dies"
    },
    {
     "role": "myth",
     "idea": "people think the big yellow flame is the hotter one"
    },
    {
     "role": "mythFact",
     "idea": "the blue flame is the hot one, near 2,000 degrees"
    },
    {
     "role": "finish",
     "idea": "a grate, a pot and a spark igniter complete the stove"
    },
    {
     "role": "congrats",
     "idea": "calm end: a blue flame under the pot"
    }
   ],
