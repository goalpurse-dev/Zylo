  "sentences": [
   {
    "role": "hook",
    "text": "If you let gas out of a pipe and light it, you have a stove."
   },
   {
    "role": "problem",
    "text": "But the yellow flame pours off soot."
   },
   {
    "role": "fix1",
    "text": "So you add a burner with air holes, so it burns blue."
   },
   {
    "role": "name",
    "text": "This is a Bunsen burner."
   },
   {
    "role": "how",
    "text": "Gas shoots up the tube and draws in about half of the air it needs through the holes."
   },
   {
    "role": "problem2",
    "text": "But a draft blows the flame out, and gas leaks."
   },
   {
    "role": "fix2",
    "text": "So you add a thermocouple that makes about 25 millivolts, and the valve shuts."
   },
   {
    "role": "myth",
    "text": "And the big yellow flame is not hotter."
   },
   {
    "role": "mythFact",
    "text": "The blue flame is the hot one, reaching roughly 1,950 to 2,000 degrees Celsius."
   },
   {
    "role": "finish",
    "text": "Add a grate, a pot and a spark igniter."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a gas stove."
   }
