  "sentences": [
   {
    "role": "hook",
    "text": "If you lay a plank across a river, you have a bridge."
   },
   {
    "role": "problem",
    "text": "But a car rolls on and snaps the plank."
   },
   {
    "role": "fix1",
    "text": "So you hang the deck from cables over two towers."
   },
   {
    "role": "name",
    "text": "This is a suspension bridge."
   },
   {
    "role": "problem2",
    "text": "But wind twists the light hanging deck."
   },
   {
    "role": "fix2",
    "text": "So you stiffen the deck with a truss."
   },
   {
    "role": "problem3",
    "text": "But the heavy truss pulls the towers inward."
   },
   {
    "role": "fix3",
    "text": "So you tie the cables to concrete anchors."
   },
   {
    "role": "problem4",
    "text": "But the cables drag the anchors toward the river."
   },
   {
    "role": "fix4",
    "text": "So you make each anchor weigh 60,000 tons."
   },
   {
    "role": "problem5",
    "text": "But the anchored cables push the towers into the bank."
   },
   {
    "role": "fix5",
    "text": "So you sink the tower footings to solid rock."
   },
   {
    "role": "finish",
    "text": "Pave the deck and add rails along the river."
   },
   {
    "role": "congrats",
    "text": "Congratulations, a car drives across your suspension bridge."
   }
  ],
