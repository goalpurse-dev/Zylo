  "why": "The kit has no setting inside the body, so the story is told on a big cut-open artery model on stands in a room: red blood dots run through it, yellow plaque narrows it, a balloon pushes the plaque back, a metal mesh stent holds it open, scar tissue grows and a drug coating stops it. The camera stays close on the artery model and ends on the whole room.",
  "story": {
   "title": "How a heart stent works",
   "hero": "a stent",
   "parts": [
    "artery",
    "blood",
    "plaque",
    "balloon",
    "metal mesh stent",
    "scar tissue",
    "drug coating",
    "guide wire",
    "catheter",
    "newspaper"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "blow up a tiny balloon inside a clogged artery and you have angioplasty"
    },
    {
     "role": "problem",
     "idea": "the balloon goes down and the plaque springs back, the blood stops again"
    },
    {
     "role": "fix1",
     "idea": "put a metal mesh tube on the balloon, it opens and stays open"
    },
    {
     "role": "problem2",
     "idea": "now scar tissue grows through the mesh and narrows it again"
    },
    {
     "role": "fix2",
     "idea": "coat the mesh with a drug that stops the scar growing"
    },
    {
     "role": "name",
     "idea": "this is a stent"
    },
    {
     "role": "how",
     "idea": "blood runs freely through the open mesh"
    },
    {
     "role": "fact",
     "idea": "the first coronary stent went into a patient in 1986"
    },
    {
     "role": "finish",
     "idea": "add the thin guide wire and the catheter that carry it in"
    },
    {
     "role": "congrats",
     "idea": "you have built a stent"
    }
   ],
   "chain": [
    {
