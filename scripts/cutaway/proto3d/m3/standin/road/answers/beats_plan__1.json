  "sentences": [
   {
    "role": "hook",
    "text": "If you drive the same strip of dirt every day, you have a road."
   },
   {
    "role": "problem",
    "text": "But rain turns the dirt to mud, and the car gets stuck."
   },
   {
    "role": "fix1",
    "text": "So you dig out the mud and pack in crushed stone."
   },
   {
    "role": "problem2",
    "text": "But now rain soaks into the stone and sits there."
   },
   {
    "role": "fix2",
    "text": "So you lay a pipe with holes under it to carry water away."
   },
   {
    "role": "problem3",
    "text": "But now cars kick up loose stones and dust."
   },
   {
    "role": "fix3",
    "text": "So you seal the top with asphalt, which locks the stone in."
   },
   {
    "role": "name",
    "text": "This is a paved road, built in layers."
   },
   {
    "role": "fact",
    "text": "Asphalt is about 95 percent stone, sand and gravel by weight."
   },
   {
    "role": "finish",
    "text": "Add a center line, a stop line and a street sign."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a road."
   }
