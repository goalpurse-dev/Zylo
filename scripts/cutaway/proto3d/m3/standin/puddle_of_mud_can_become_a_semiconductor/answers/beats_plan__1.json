 "data": {
  "why": "A chip factory grows out of a muddy pit on a plain lawn: the pit in section in front, where muddy water settles to sand, and a row of machines right behind it (an arc furnace with a carbon bin, a crystal puller, a light printer and a wafer rack), which a factory hall is built around at the end to make a cleanroom. The camera opens close on the pit, then frames each machine in mid shots as it is added, and ends on the lit hall with the clear pit in front.",
  "story": {
   "title": "How a puddle of mud becomes a chip factory",
   "hero": "a Czochralski crystal puller",
   "parts": [
    "muddy pit",
    "sand",
    "battery and bulb",
    "clay and iron",
    "arc furnace",
    "carbon",
    "gas",
    "crystal puller",
    "silicon crystal",
    "wafers",
    "light printer",
    "dust",
    "rain and mud",
    "factory hall",
    "filtered air",
    "ceiling lights"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "dig a pit and let muddy water settle and you get a sandy floor"
    },
    {
     "role": "problem",
     "idea": "sand is silicon locked to oxygen, so no current passes and the bulb stays dark"
    },
    {
     "role": "stakes",
     "idea": "the sand is full of clay and iron, yet a chip allows only one foreign atom per billion"
    },
    {
     "role": "fix1",
     "idea": "pour the sand into a furnace with carbon"
    },
    {
     "role": "fix2",
     "idea": "heat it to about 2,000 degrees Celsius and the oxygen burns off as gas"
    },
    {
     "role": "fix3",
     "idea": "melt the pure silicon and pull one single crystal out of it"
    },
    {
     "role": "name",
     "idea": "this is a Czochralski crystal puller"
    },
    {
     "role": "name2",
     "idea": "slice the crystal into thin discs: each disc is a wafer"
    },
    {
     "role": "how",
     "idea": "machines print layer after layer of tiny switches onto each wafer with light"
    },
    {
     "role": "fact",
     "idea": "one modern chip holds over 20 billion of those switches"
    },
    {
     "role": "problem2",
     "idea": "a single speck of dust landing on a wafer can kill the chip"
    },
    {
     "role": "problem3",
     "idea": "out in the open, rain blows mud onto the machines and ruins a batch"
    },
    {
     "role": "fix4",
     "idea": "build a hall around the machines and push filtered air down: a cleanroom"
    },
    {
     "role": "finish",
     "idea": "ceiling lights over the machines, and the pit water runs clear"
    },
    {
     "role": "congrats",
     "idea": "you have built a semiconductor factory"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "a battery's bulb wired into the sand stays dark",
     "stakes": "sand cannot carry current, so no chip",
