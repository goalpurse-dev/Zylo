   "surprises": [
    {
     "claim": "The Holland Tunnel under the Hudson River has 84 ventilation fans that change all its air every 90 seconds.",
     "role": "fact",
     "search": "Holland Tunnel 84 fans air changed every 90 seconds"
    },
    {
     "claim": "Marc Brunel's tunnelling shield made the Thames Tunnel (opened 1843) the first tunnel under a navigable river.",
     "role": "fix1",
     "search": "Thames Tunnel 1843 first tunnel under navigable river Brunel shield"
    },
    {
     "claim": "A tunnel boring machine lines the tunnel with concrete rings as it goes, each ring bolted from curved segments.",
     "role": "fix2",
     "search": "tunnel boring machine segment lining rings bolted"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you dig a shaft and a hole under a river, you have a tunnel."
   },
   {
    "role": "problem",
    "text": "But the soft mud caves in, and river water floods the hole."
   },
   {
    "role": "fix1",
    "text": "So you push a steel shield forward that holds the mud back."
   },
   {
    "role": "fix2",
    "text": "Behind it, you line the walls with rings of concrete segments."
   },
   {
    "role": "name",
    "text": "This is a tunnel boring machine."
   },
   {
    "role": "how",
    "text": "Its wheel spins and cuts, and a belt carries the mud out."
   },
   {
    "role": "problem2",
    "text": "But now the long, closed tunnel fills with smoky air."
   },
   {
    "role": "fix3",
    "text": "So you add big fans that push in fresh air."
   },
   {
    "role": "fact",
    "text": "In the Holland Tunnel, 84 fans change all its air every 90 seconds."
   },
   {
    "role": "finish",
    "text": "Add a road and lights along the ceiling."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a tunnel under a river."
   }
  ],
