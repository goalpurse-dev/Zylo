    {
     "role": "fact",
     "idea": "a Mercedes S-Class turns its rear wheels up to 10 degrees, about 2 meters off its turning circle"
    },
    {
     "role": "problem2",
     "idea": "fast: opposite rear wheels whip the tail round"
    },
    {
     "role": "fix2",
     "idea": "above about 37 mph the rear wheels turn the same way and the truck tracks straight"
    },
    {
     "role": "name2",
