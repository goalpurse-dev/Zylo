   "surprises": [
    {
     "claim": "Mercedes S-Class rear-axle steering turns the rear wheels up to 10 degrees and cuts the turning circle by up to about 2 meters",
     "role": "fact",
     "search": "Mercedes S-Class rear axle steering 10 degrees turning circle 2 meters"
    },
    {
     "claim": "On the Mercedes S-Class, the rear wheels turn opposite the front below about 60 km/h (37 mph) and the same way above that",
     "role": "fix2",
     "search": "Mercedes S-Class rear wheel steering 60 km/h same direction"
    },
    {
     "claim": "Some rear-steer systems, such as BMW's Integral Active Steering and one DAF truck rear axle, are designed so a fault leaves the rear wheels centred or straight",
     "role": "fix3",
     "search": "rear wheel steering fault rear wheels centred straight"
    }
