   ],
   "surprises": [
    {
     "claim": "Older Cessna 172s, such as the 172R, have a maximum takeoff weight of about 2,450 lb (1,111 kg); newer 172S models are certified to 2,550 lb (1,157 kg).",
     "role": "stakes",
     "search": "Cessna 172R maximum takeoff weight 2450 lb"
    },
    {
     "claim": "A Cessna 172 rotates at about 55 knots indicated airspeed, roughly 100 km/h.",
     "role": "how",
     "search": "Cessna 172 rotation speed 55 knots"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you bolt two wings onto a tube, you have an airplane."
   },
   {
    "role": "problem",
    "text": "But the flat wings give no lift, so the wheels turn and the plane sits on the runway."
   },
   {
    "role": "stakes",
    "text": "An older Cessna 172 weighs about 2,450 pounds, and gravity pins every pound of it down."
   },
   {
    "role": "fix1",
    "text": "So you add an engine and a propeller, but the air just slides past the flat wings."
   },
   {
    "role": "fix2",
    "text": "So you curve the top of the wing, and the air speeds up over it and the wing lifts."
   },
   {
    "role": "fix3",
    "text": "But now the nose wanders, so you add a tail with a fin and a stabilizer that hold the nose pointing straight."
   },
   {
    "role": "fix4",
    "text": "Then you hinge the back of the tail, so the rudder swings the nose sideways and the elevator tilts it up."
   },
   {
    "role": "name",
    "text": "This is an airplane."
   },
   {
    "role": "name2",
    "text": "The curved wing shape is called an airfoil."
   },
   {
    "role": "how",
    "text": "At about 100 kilometers per hour, the air over the wings lifts the plane off the runway."
   },
   {
    "role": "problem2",
    "text": "But a gust of wind pushes one wing down, and the plane tips onto its side."
   },
   {
    "role": "problem3",
    "text": "And to land, the plane must slow down, but at 100 kilometers per hour it is far too fast."
   },
   {
    "role": "fix5",
    "text": "So you add flaps on the wings that level the plane and slow it until it settles onto the runway."
   },
   {
    "role": "finish",
    "text": "Add a door, windows and stairs so people can board."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built an airplane."
   }
  ],
