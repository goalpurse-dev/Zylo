  "why": "A portable air conditioner standing on the kitchen floor, cut open: a fan beside an icy coil above a tray, a compressor and a hot coil below, a duct to a vent in the wall. The camera stays on the unit; the opening is close on the fan and the frosting coil.",
  "story": {
   "title": "How an air conditioner works",
   "hero": "an air conditioner",
   "parts": [
    "fan",
    "cold coil",
    "drip tray",
    "drain hose",
    "compressor",
    "coolant pipes",
    "hot coil",
    "exhaust duct",
    "wall vent",
    "louvers",
    "display",
    "filter"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "blow a fan through an icy coil and you already have an air conditioner"
    },
    {
     "role": "problem",
     "idea": "the cold coil pulls water out of the air and it drips onto the floor"
    },
    {
     "role": "fix1",
     "idea": "a tray under the coil and a hose drain the water away"
    },
    {
     "role": "problem2",
     "idea": "with nothing keeping it cold the coil warms up and blows warm air"
    },
    {
     "role": "fix2",
     "idea": "a compressor pumps coolant round to keep the coil cold"
    },
    {
     "role": "name",
     "idea": "this box with a fan, coils and a compressor is an air conditioner"
    },
    {
     "role": "how",
     "idea": "the heat goes to a hot coil and out through the wall along a duct"
    },
    {
     "role": "myth",
     "idea": "people think air conditioning was invented for comfort"
    },
    {
     "role": "mythFact",
     "idea": "Carrier designed it in 1902 to stop printing paper swelling"
    },
    {
     "role": "finish",
     "idea": "louvers, a display and a filter complete the unit"
    },
    {
     "role": "congrats",
     "idea": "calm end: the finished unit humming"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "water drips off the cold coil and splashes on the floor",
     "stakes": "the floor gets soaked",
     "size": 3
    },
    {
     "problem": "problem2",
