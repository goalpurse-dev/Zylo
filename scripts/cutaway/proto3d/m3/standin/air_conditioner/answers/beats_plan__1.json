   "surprises": [
    {
     "claim": "In 1902 Willis Carrier designed an air conditioning system for a printing plant in Brooklyn",
     "role": "mythFact",
     "search": "Willis Carrier 1902 Sackett-Wilhelms printing plant Brooklyn"
    },
    {
     "claim": "Carrier's system was built to control humidity so the paper would not swell and the colours would line up",
     "role": "mythFact",
     "search": "Carrier 1902 humidity paper printing why invented"
    },
    {
     "claim": "An air conditioner's cold coil pulls water out of the air, which drips into a pan and drains away",
     "role": "problem",
     "search": "air conditioner evaporator coil condensation drain pan"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you blow a fan through an icy coil, you have an air conditioner."
   },
   {
    "role": "problem",
    "text": "But the cold coil pulls water from the air, and it drips onto the floor."
   },
   {
    "role": "fix1",
    "text": "So you add a tray and a hose that drains the water away."
   },
   {
    "role": "problem2",
    "text": "But now the coil warms up, and warm air blows into the room."
   },
   {
    "role": "fix2",
    "text": "So you add a compressor that pumps coolant to keep the coil cold."
   },
   {
    "role": "name",
    "text": "This is an air conditioner."
   },
   {
    "role": "how",
    "text": "The heat goes to a hot coil and out through the wall."
   },
   {
    "role": "myth",
    "text": "And comfort is not why air conditioning was invented."
   },
   {
    "role": "mythFact",
    "text": "Willis Carrier designed it in 1902 so printing paper would not swell."
   },
   {
    "role": "finish",
    "text": "Add louvers, a display and a filter."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built an air conditioner."
   }
  ],
