{
 "hash": "*",
 "by": "stand-in planner",
 "searches": 0,
 "data": {
  "why": "A brake test stand in the home workshop: a car wheel on a spinning hub, cut open so the disc, the caliper, the brake pipe and the pedal all show side by side. The camera opens close on a wooden block pressed onto the spinning tyre, pulls back to the whole stand as the disc, pedal and fluid pipe arrive, goes close on the glowing disc and its vents, and ends wide on the finished wheel stopping.",
  "story": {
   "title": "How car brakes work",
   "hero": "a disc brake",
   "parts": [
    "wheel",
    "tyre",
    "block",
    "disc",
    "caliper",
    "pads",
    "pedal",
    "master cylinder",
    "brake pipe",
    "brake fluid",
    "vents"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "press a block onto a spinning tyre and you have a brake"
    },
    {
     "role": "problem",
     "idea": "the block rubs the tyre itself and smoke pours off the rubber"
    },
    {
     "role": "fix1",
     "idea": "bolt a steel disc to the hub and squeeze that instead"
    },
    {
     "role": "problem2",
     "idea": "a hand or foot alone is too weak, the wheel keeps spinning at 60"
    },
    {
     "role": "fix2",
     "idea": "a pedal pushes fluid down a pipe to a caliper that squeezes the disc with many times the force"
    },
    {
     "role": "name",
     "idea": "this is a disc brake"
    },
    {
     "role": "how",
     "idea": "pedal down, fluid moves, pads clamp, the speed falls to zero"
    },
    {
     "role": "problem3",
     "idea": "hard stops make the disc glow red hot and the brakes fade"
    },
    {
     "role": "fix3",
     "idea": "cut vents through the disc so air cools it"
    },
    {
     "role": "fact",
     "idea": "a hard stop can heat a disc to hundreds of degrees"
    },
    {
     "role": "finish",
     "idea": "add a brake light that glows when you press the pedal"
    },
    {
     "role": "congrats",
     "idea": "you have built a disc brake"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "smoke pours off the tyre under the block",
     "stakes": "the tyre wears bald",
     "size": 4
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "the speed gauge stays at 60 while the disc spins on",
     "stakes": "the car cannot stop",
     "size": 7
    },
    {
     "problem": "problem3",
     "causedBy": "fix2",
     "shows": "the disc glows red hot",
     "stakes": "the brakes fade on a long hill",
     "size": 9
    }
   ],
   "surprises": [
    {
     "claim": "Brake fluid cannot be squeezed, so the small piston at the pedal moves big caliper pistons with several times the force",
     "role": "fix2",
     "search": "hydraulic brake force multiplication master cylinder caliper piston ratio"
    },
    {
     "claim": "In a hard stop a brake disc can heat to over 500 degrees Celsius",
     "role": "fact",
     "search": "brake disc temperature hard braking degrees celsius"
    },
    {
     "claim": "Vented discs have air channels between two faces that pump cooling air",
     "role": "fix3",
     "search": "vented brake rotor cooling vanes how it works"
    }
   ]
  },
