{
 "hash": "*",
 "by": "stand-in planner (replan 2026-11-09)",
 "searches": 0,
 "data": {
  "why": "A cut-open disc brake on a stand in a home workshop: a block presses the spinning tyre, then a disc, caliper, pedal and fluid pipe are added one by one. Close shots on the tyre and disc for each change, wider shots when the pedal and gauges join.",
  "story": {
   "title": "How Car Brakes Work",
   "hero": "a disc brake",
   "parts": [
    "tire",
    "wooden block",
    "steel disc",
    "caliper",
    "pads",
    "pedal",
    "brake fluid pipe",
    "vents",
    "brake light"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "pressing a block on a spinning tire is the simplest brake"
    },
    {
     "role": "problem",
     "idea": "the rubber grinds against the block and smokes"
    },
    {
     "role": "fix1",
     "idea": "a steel disc on the hub is squeezed instead of the tire"
    },
    {
     "role": "problem2",
     "idea": "a hand is too weak to stop the spinning disc"
    },
    {
     "role": "fix2",
     "idea": "a pedal pushes fluid down a pipe, which multiplies the push four to five times"
    },
    {
     "role": "name",
     "idea": "the disc and its caliper are a disc brake"
    },
    {
     "role": "how",
     "idea": "the pedal pushes, the pads clamp the disc and the wheel stops"
    },
    {
     "role": "problem3",
     "idea": "hard stops heat the disc until it glows"
    },
    {
     "role": "fix3",
     "idea": "vents let air through the disc to cool it"
    },
    {
     "role": "fact",
     "idea": "repeated hard stops can push a disc past 500 degrees Celsius"
    },
    {
     "role": "finish",
     "idea": "a brake light completes it"
    },
    {
     "role": "congrats",
     "idea": "the finished disc brake, calm"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "smoke pours off the tire under the block",
     "stakes": "the tire wears out",
     "size": 3
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "the disc keeps spinning, the speed stays up",
     "stakes": "the car cannot stop",
     "size": 5
    },
    {
     "problem": "problem3",
     "causedBy": "fix2",
     "shows": "the disc glows red hot",
     "stakes": "the brakes fade",
     "size": 7
    }
   ],
   "surprises": [
    {
     "claim": "Brake fluid carries your push from a small piston at the pedal to bigger pistons at the wheel, multiplying the force about four to five times",
     "role": "fix2",
     "search": "hydraulic brake force multiplication master cylinder caliper"
    },
    {
     "claim": "Repeated hard stops from high speed can heat a brake disc past 500 degrees Celsius",
     "role": "fact",
     "search": "brake disc temperature hard stops 500 C"
    },
    {
     "claim": "Vented discs have air channels between their two faces whose vanes pump cooling air",
     "role": "fix3",
     "search": "vented brake disc vanes cooling air"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you press a block onto a spinning tire, you have a brake."
   },
   {
    "role": "problem",
    "text": "But the rubber grinds, and smoke pours off."
   },
   {
    "role": "fix1",
    "text": "So you bolt on a steel disc and squeeze it."
   },
   {
    "role": "problem2",
    "text": "But your hand is weak, and the disc keeps spinning."
   },
   {
    "role": "fix2",
    "text": "So you add a pedal, a pipe and fluid that multiplies your push four to five times."
   },
   {
    "role": "name",
    "text": "This is a disc brake."
   },
   {
    "role": "how",
    "text": "Push the pedal, the pads clamp, and the wheel stops."
   },
   {
    "role": "problem3",
    "text": "But now hard stops heat the disc until it glows red."
   },
   {
    "role": "fix3",
    "text": "So you cut vents, and air cools the disc."
   },
   {
    "role": "fact",
    "text": "Repeated hard stops can heat a disc past 500 degrees Celsius."
   },
   {
    "role": "finish",
    "text": "Add a brake light that glows when you brake."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a disc brake."
   }
  ],
