 "data": {
  "why": "A big cut-open engine on the floor of a home workshop: one glass cylinder is built up step by step (fire, cap and piston, rod and crankshaft, a water pump), then three more cylinders and a flywheel finish it. Every shot frames the cylinder or the whole engine close, never the room.",
  "story": {
   "title": "How a Car Engine Works",
   "hero": "a car engine",
   "parts": [
    "metal tube",
    "fire",
    "cap",
    "piston",
    "rod",
    "crankshaft",
    "spark plug",
    "water pump",
    "cylinders",
    "flywheel"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "burning fuel in a tube is the start of an engine"
    },
    {
     "role": "problem",
     "idea": "an open tube lets the blast escape, so nothing moves"
    },
    {
     "role": "fix1",
     "idea": "a cap and a piston trap the blast"
    },
    {
     "role": "problem2",
     "idea": "the blast slams the piston down once and it sticks"
    },
    {
     "role": "fix2",
     "idea": "a rod and a crankshaft turn the push into a spin and bring the piston back up"
    },
    {
     "role": "problem3",
     "idea": "blast after blast heats the tube until it glows"
    },
    {
     "role": "fix3",
     "idea": "a pump runs cool water round the tube"
    },
    {
     "role": "name",
     "idea": "this is a car engine"
    },
    {
     "role": "how",
     "idea": "a spark fires the fuel, the piston goes down, the rod spins the crankshaft"
    },
    {
     "role": "finish",
     "idea": "more cylinders in a row and a flywheel complete it"
    },
    {
     "role": "congrats",
     "idea": "the finished engine running"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "the blast bursts out of the open top in smoke",
     "stakes": "the energy is wasted",
     "size": 3
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "the piston slams to the bottom and stays",
