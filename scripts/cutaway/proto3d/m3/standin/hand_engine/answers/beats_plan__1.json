   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you burn fuel inside a tube, you have an engine."
   },
   {
    "role": "problem",
    "text": "But the blast just bangs out the top, and nothing turns."
   },
   {
    "role": "fix1",
    "text": "So you cap the tube and fit a piston inside."
   },
   {
    "role": "problem2",
    "text": "But now the blast slams the piston down, and it sticks."
   },
   {
    "role": "fix2",
    "text": "So you add a rod and a crankshaft that spins and lifts it."
   },
   {
    "role": "problem3",
    "text": "But now the blasts heat the tube until it glows red."
   },
   {
    "role": "fix3",
    "text": "So you add a pump that runs cool water around the tube."
   },
   {
    "role": "name",
    "text": "This is a car engine."
   },
   {
    "role": "how",
    "text": "A spark fires the fuel, the blast shoves the piston down, and the rod spins the crankshaft."
   },
   {
    "role": "finish",
    "text": "Add three more cylinders in a row and a flywheel."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a car engine."
   }
  ],
