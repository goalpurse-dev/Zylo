 "data": {
  "why": "A gas water heater in a home garage (the workshop setting), cut open: a glass tank of water on a stand with a big blue burner flame under it, a foam jacket, a thermostat, a dip tube and a hot pipe. The water's colour tells the heat (blue cold, orange hot); every shot stays on the heater, the opening close on the tank and its flame.",
  "story": {
   "title": "How a water heater works",
   "hero": "a water heater",
   "parts": [
    "tank",
    "flame",
    "foam jacket",
    "thermostat",
    "dip tube",
    "hot pipe",
    "anode rod",
    "relief valve",
    "flue",
    "drain valve"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "heat a tank of water over a flame and you already have a water heater"
    },
    {
     "role": "problem",
     "idea": "the heat leaks out through the thin walls and the water cools again"
    },
    {
     "role": "fix1",
     "idea": "a thick foam jacket keeps the heat in"
    },
    {
     "role": "problem2",
     "idea": "now nothing escapes, so the water keeps heating until it steams"
    },
    {
     "role": "fix2",
     "idea": "a thermostat shuts the flame off at 120 degrees Fahrenheit"
    },
    {
     "role": "name",
     "idea": "this insulated tank with a burner and a thermostat is a water heater"
    },
    {
     "role": "how",
     "idea": "cold water goes down the dip tube to the bottom, hot water leaves from the top"
    },
    {
     "role": "myth",
     "idea": "the rod inside looks like a heating element, but it is not"
    },
    {
     "role": "mythFact",
     "idea": "it is an anode rod that rusts away so the steel tank does not"
    },
    {
     "role": "finish",
     "idea": "a relief valve, a flue and a drain complete the heater"
    },
    {
     "role": "congrats",
     "idea": "calm end: the finished heater with its blue flame"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "orange heat arrows stream out of the walls and the water turns back to blue",
     "stakes": "the shower runs cold and the gas is wasted",
     "size": 3
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "the water inside the foam turns hot orange and steam pours off the top",
     "stakes": "scalding water",
     "size": 7
    }
   ],
   "surprises": [
    {
     "claim": "The Department of Energy suggests setting a water heater to 120 degrees Fahrenheit",
     "role": "fix2",
     "search": "energy.gov water heater temperature 120 degrees"
    },
    {
     "claim": "A dip tube carries the cold water to the bottom of the tank",
     "role": "how",
     "search": "water heater dip tube cold water bottom of tank"
    },
    {
     "claim": "The anode rod, usually magnesium or aluminum, corrodes instead of the steel tank",
     "role": "mythFact",
     "search": "water heater anode rod sacrificial magnesium aluminum corrodes"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you heat a tank of water over a flame, you have a water heater."
   },
   {
    "role": "problem",
    "text": "But the heat leaks out through the thin walls, and the water cools."
   },
   {
    "role": "fix1",
    "text": "So you wrap the tank in a thick foam jacket."
   },
   {
    "role": "problem2",
    "text": "But now the foam traps it all, and the water keeps heating."
   },
   {
    "role": "fix2",
    "text": "So you add a thermostat that shuts the flame off at 120 degrees Fahrenheit."
   },
   {
    "role": "name",
    "text": "This is a water heater."
   },
   {
    "role": "how",
    "text": "A dip tube carries cold water down, and hot water leaves the top."
   },
   {
    "role": "myth",
    "text": "And the rod inside is not a heater."
   },
   {
    "role": "mythFact",
    "text": "It is an anode rod that rusts instead of the steel tank."
   },
   {
    "role": "finish",
    "text": "Add a relief valve, a flue and a drain."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a water heater."
   }
  ],
