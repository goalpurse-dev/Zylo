 "searches": 0,
 "data": {
  "why": "A fridge in a kitchen, cut open with its working parts in front: food and a block of ice on one shelf, then a frosting coil on the back wall, a compressor and hot coils in the bottom compartment, a display at the top that counts the temperature. Every shot stays on the fridge; the opening is close on the food and ice.",
  "story": {
   "title": "How a fridge works",
   "hero": "a refrigerator",
   "parts": [
    "food",
    "block of ice",
    "cooling coil",
    "compressor",
    "coils underneath",
    "pipes",
    "door",
    "shelves",
    "light"
   ],
   "ideas": [
    {
     "role": "hook",
     "idea": "put food in a box with a block of ice and you already have a fridge"
    },
    {
     "role": "problem",
     "idea": "the ice melts and its water pools round the food"
    },
    {
     "role": "fix1",
     "idea": "a coil of liquid that boils at minus 26 degrees frosts over and keeps the box cold"
    },
    {
     "role": "problem2",
     "idea": "once the liquid has boiled away the frost melts and the box warms up to 15 degrees"
    },
    {
     "role": "fix2",
     "idea": "a compressor squeezes the gas back into a liquid and pumps it round, so the coil frosts again"
    },
    {
     "role": "name",
     "idea": "this box with a coil, a compressor and pipes is a refrigerator"
    },
    {
     "role": "how",
     "idea": "squeezing makes the gas hot, so the coils underneath shed that heat into the kitchen"
    },
    {
     "role": "fact",
     "idea": "inside it holds your food at 4 degrees"
    },
    {
     "role": "myth",
     "idea": "the cold you feel is not blown in"
    },
    {
     "role": "mythFact",
     "idea": "a fridge only moves heat out of the box to the coils"
    },
    {
     "role": "finish",
     "idea": "a door, shelves and a light complete the fridge"
    },
    {
     "role": "congrats",
     "idea": "calm end: the finished fridge with its light on"
    }
   ],
   "chain": [
    {
     "problem": "problem",
     "causedBy": "hook",
     "shows": "the ice block shrinks and its water pools round the food",
     "stakes": "the food sits in water and warms",
     "size": 3
    },
    {
     "problem": "problem2",
     "causedBy": "fix1",
     "shows": "the frost melts off the coil and the display climbs to 15",
