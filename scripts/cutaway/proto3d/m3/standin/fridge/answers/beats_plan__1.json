    }
   ],
   "surprises": [
    {
     "claim": "The refrigerant R-134a boils at about minus 26 degrees Celsius at normal air pressure",
     "role": "fix1",
     "search": "R-134a boiling point atmospheric pressure"
    },
    {
     "claim": "Food safety agencies say a fridge should be at 4 degrees Celsius (40 F) or colder",
     "role": "fact",
     "search": "FDA refrigerator temperature 40 F 4 C"
    },
    {
     "claim": "A fridge does not make cold; it moves heat from inside the box to the coils outside",
     "role": "mythFact",
     "search": "how a refrigerator moves heat condenser coils"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you put food in a box with ice, you have a fridge."
   },
   {
    "role": "problem",
    "text": "But the ice melts, and water pools round the food."
   },
   {
    "role": "fix1",
    "text": "So you add a coil of liquid that boils at minus 26 degrees, and it frosts."
   },
   {
    "role": "problem2",
    "text": "But the coil's liquid boils away, the frost melts and the box warms."
   },
   {
    "role": "fix2",
    "text": "So you add a compressor that squeezes the gas back into a liquid."
   },
   {
    "role": "name",
    "text": "This is a refrigerator."
   },
   {
    "role": "how",
    "text": "Squeezing makes the gas hot, so coils underneath shed that heat."
   },
   {
    "role": "fact",
    "text": "It holds your food at 4 degrees Celsius."
   },
   {
    "role": "myth",
    "text": "And the cold is not blown in."
   },
   {
    "role": "mythFact",
    "text": "A fridge only moves heat out to the coils outside."
   },
   {
    "role": "finish",
    "text": "Add a glass door, shelves and a light."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a fridge."
   }
  ],
