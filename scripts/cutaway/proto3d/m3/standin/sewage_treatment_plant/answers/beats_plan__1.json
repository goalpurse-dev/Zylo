     "role": "hook",
     "idea": "pipe the town's toilets straight into the river and you have a sewer"
    },
    {
     "role": "problem",
     "idea": "the river turns brown"
    },
    {
     "role": "fix1",
     "idea": "send it into a tank where solids sink and scum floats"
    },
    {
     "role": "problem2",
     "idea": "the tank only takes out part of the waste, the gauge stops at 65 percent left"
    },
    {
     "role": "fix2",
     "idea": "a second tank where air bubbles feed bacteria that eat the dissolved waste"
    },
    {
     "role": "name",
     "idea": "this is a sewage treatment plant"
    },
    {
     "role": "how",
     "idea": "clear water flows back to the river and it turns clean"
    },
    {
     "role": "problem3",
     "idea": "now sludge piles up on the tank floors"
    },
    {
     "role": "fix3",
     "idea": "pump the sludge to a digester where bacteria turn it into gas that burns"
    },
    {
     "role": "fact",
     "idea": "each person sends tens of gallons of wastewater a day"
    },
    {
     "role": "finish",
     "idea": "add a fence and young trees round the plant"
    },
