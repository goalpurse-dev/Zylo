   "surprises": [
    {
     "claim": "Photoelectric alarms aim a light beam away from a sensor; smoke scatters the light onto the sensor and sets off the alarm",
     "role": "fix1",
     "search": "photoelectric smoke alarm light scattered onto sensor how it works"
    },
    {
     "claim": "Smoke alarm horns must sound at least 85 decibels at 10 feet",
     "role": "fix2",
     "search": "smoke alarm 85 decibels 10 feet UL 217 NFPA 72"
    },
    {
     "claim": "The NFPA says to replace smoke alarms every 10 years",
     "role": "fact",
     "search": "NFPA replace smoke alarms every 10 years"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you shine a light beam through a dark box, you have a smoke detector."
   },
   {
    "role": "problem",
    "text": "But when smoke drifts up from a burning trash can, the beam just keeps shining."
   },
   {
    "role": "fix1",
    "text": "So you add a sensor off to the side, and smoke bounces light onto it."
   },
   {
    "role": "problem2",
    "text": "But a sensor makes no sound, and at night everyone sleeps through the fire."
   },
   {
    "role": "fix2",
    "text": "So you add a horn that blares at least 85 decibels at 10 feet."
   },
   {
    "role": "name",
    "text": "This is a photoelectric smoke detector."
   },
   {
    "role": "fact",
    "text": "Fire safety experts say to replace it every 10 years."
   },
   {
    "role": "finish",
    "text": "Add a battery, a test button and vents."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built a smoke detector."
   }
