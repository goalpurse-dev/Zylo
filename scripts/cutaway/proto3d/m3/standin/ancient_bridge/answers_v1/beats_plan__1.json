   "surprises": [
    {
     "claim": "Stone is typically about 10 to 20 times stronger in compression than in tension, depending on the rock.",
     "role": "problem2",
     "search": "rock compressive vs tensile strength ratio 10 to 20"
    },
    {
     "claim": "The Pons Fabricius in Rome was built in 62 BC and still carries walkers after more than 2000 years",
     "role": "how",
     "search": "Pons Fabricius 62 BC oldest bridge Rome still in use"
    }
   ]
  },
  "sentences": [
   {
    "role": "hook",
    "text": "If you lay a plank across a river, you have a bridge."
   },
   {
    "role": "problem",
    "text": "But a cart loaded with stone rolls on and the plank snaps."
   },
   {
    "role": "fix1",
    "text": "So you build stone piers on both banks and rest slabs on top."
   },
   {
    "role": "problem2",
    "text": "But now the slab cracks, because stone is about 10 to 20 times stronger in compression than in tension."
   },
   {
    "role": "fix2",
    "text": "So you set a wooden frame, curve wedge stones over it, and lock a keystone on top."
   },
   {
    "role": "name",
    "text": "This is an arch bridge."
   },
   {
    "role": "how",
    "text": "The weight squeezes the stones down the curve into the piers."
   },
   {
    "role": "fix3",
    "text": "So you pull the frame away, and the arch holds itself."
   },
   {
    "role": "finish",
    "text": "Add a stone road and low walls, and a cart rolls across."
   },
   {
    "role": "congrats",
    "text": "Congratulations, you have built an arch bridge."
   }
  ],
