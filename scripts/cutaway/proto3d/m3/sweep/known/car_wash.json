rams":{"at":[9.5,0.1,-9],"rotY":0.2,"scale":1}},{"id":"stormDrain","kind":"grate","params":{"depth":0.9,"pos":[11.2,0.1,-1],"width":1.3}},{"id":"stormPipe","kind":"pipeRun","params":{"mat":"concrete","path":[[11.2,-0.15,-0.06],[11.2,-1.4,-0.06],[14.7,-1.4,-0.06],[14.7,-0.45,-0.06]],"r":0.2}},{"id":"stormFlow","kind":"pipeRunFlow","params":{"count":14,"dz":0.28,"mat":"water","pipe":"stormPipe","size":0.16,"speed":2.6}},{"id":"stormPipeOutfall","kind":"flow","params":{"look":"soap","path":[[14.7,-0.45,0.04000000000000001],[15.149999999999999,-0.2,-0.25],[15.599999999999998,0.06,-0.9]],"size":0.2,"speed":2.4}},{"id":"tankWater","kind":"water","params":{"box":{"x0":-5.08,"x1":-1.92,"y0":-4.78,"y1":-1.7,"z0":-3.58,"z1":-0.01},"mat":"water"}}],"roles":["hook","problem","fix1","problem2","fix2","name","how","fact","myth","mythFact","finish","congrats"],"template":true,"title":"How a Car Wash Works","why":"A car wash in section: the car arrives, a hose smears mud, an arch with soap and cloth strips fixes it, and a floor drain leads to an underground reclaim tank where sand sinks and oil rises. A pump returns the water to the arch, and the myth is shown with a hose flooding the floor. I changed the two props to the allowed types kiosk and vacuum, ended the waste-water fill at the face, and re-aimed or tightened the shots so they hold the cut.","world":{"backdrop":{"back":-8,"color":"#2f6fb0","h":5.2,"sign":"SPLASH CAR WASH","type":"carwash","x0":-7,"x1":7},"cut":{"depth":6,"x0":-5.5,"x1":-1.5,"z0":-4},"house":false,"moreTrees":false,"porch":false,"road":false,"rocksAvoid":[[-6.8,-0.9,-5.4,-0.8],[10.4,15.2,-1.9,0.1]],"roots":{"pad":0.8,"to":7},"sat":1.404,"trees":[[-13,-11.5,1],[22,-3.4,0.9]],"worker":false}},"sentences":[{"role":"hook","text":"If you spray a muddy car with a hose, you have a car wash."},{"role":"problem","text":"But the mud just smears on the paint."},{"role":"fix1","text":"So you build an arch with soap sprays and cloth strips."},{"role":"problem2","text":"But the soapy water runs into the creek."},{"role":"fix2","text":"So you cut a floor drain into an underground tank."},{"role":"name","text":"This is a water reclaim tank."},{"role":"how","text":"Sand sinks, oil rises, and clean water goes to a pump."},{"role":"fact","text":"That pump sends up to 80 percent of the water back to the arch."},{"role":"myth","text":"And a car wash does not waste more water than a hose."},{"role":"mythFact","text":"It uses about 15 gallons of fresh water a car, but a hose can use up to 140."},{"role":"finish","text":"Add a pay kiosk, a vacuum station, and a canopy."},{"role":"congrats","text":"Congratulations, you have built a car wash."}]}