focus":["battery","pump"],"width":0.8}]},{"s":"myth","shows":{"p":"sewerSheet","does":"a newspaper saying the water goes to the sewer rises"},"do":[{"p":"sewerSheet","v":"show","w":"sewer"}],"shots":[{"at":{"s":"myth","w":"sewer"},"focus":["sewerSheet"],"width":0.7}]},{"s":"mythFact","shows":{"p":"outFlow","does":"water runs along the pipe and out through the wall"},"do":[{"p":"sewerSheet","v":"hide","w":"It"},{"p":"outFlow","v":"start","w":"outside"}],"shots":[{"focus":["outPipe","outFlow"],"width":0.8}]},{"s":"finish","shows":{"p":"stairs","does":"stairs and a ceiling light appear in the dry basement"},"do":[{"p":"outFlow","v":"stop","w":"Add"},{"p":"flowOut","v":"hide","w":"Add"},{"p":"stairs","v":"show","w":"stairs"},{"p":"ceilingLight","v":"show","w":"light","o":-0.7}],"shots":[{"focus":["dig","stairs","ceilingLight"],"width":0.85}]},{"s":"congrats","shows":{"p":"pump","does":"the pump stands ready, its lamp blinking, in a dry basement"},"do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","flood","stakes","fix1","name","how","fact","problem2","fix3","name2","problem3","fix4","myth","mythFact","finish","congrats"]},"sentences":[{"role":"hook","text":"If you dig a hole in the basement floor, you have a sump."},{"role":"problem","text":"But after rain, groundwater seeps up into the hole."},{"role":"flood","text":"Then it floods the floor, and one inch over 1,000 square feet is about 600 gallons."},{"role":"stakes","text":"FEMA says one inch can cause up to 25,000 dollars in damage, and the wall cracks."},{"role":"fix1","text":"So you add a basin, and the water runs into it."},{"role":"name","text":"This is a sump pump."},{"role":"how","text":"When the water rises, a float switches the pump on, and it pushes the water up the pipe."},{"role":"fact","text":"A typical pump moves roughly 2,000 gallons per hour or more."},{"role":"problem2","text":"But now when the pump stops, the water in the pipe falls back into the basin."},{"role":"fix3","text":"So you add a valve that lets water go up, never back down."},{"role":"name2","text":"This is a check valve."},{"role":"problem3","text":"But now a storm cuts the power, the pump stops, and the basin overflows."},{"role":"fix4","text":"So you add a battery that keeps the pump running."},{"role":"myth","text":"And this water is not sent to the sewer."},{"role":"mythFact","text":"It pumps the water outside, into the yard or a storm drain."},{"role":"finish","text":"Add stairs and a ceiling light."},{"role":"congrats","text":"Congratulations, you have built a sump pump."}]}