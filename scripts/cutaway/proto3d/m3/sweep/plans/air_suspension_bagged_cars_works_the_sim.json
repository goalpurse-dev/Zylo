xt":"TOO HIGH","w":"high"},"do":[{"p":"ride","v":"high","w":"swells"},{"p":"ride","v":"bodyHigh","w":"swells"}],"shots":[{"focus":["ride"],"width":0.94}]},{"s":"fix3","shows":{"p":"kit","does":"a gold valve appears on the hose, its green lamp lights and the car settles back down"},"do":[{"p":"kit","v":"valve","w":"valve"},{"p":"kit","v":"opens","w":"valve","o":0.3},{"p":"ride","v":"highBack","w":"settles"},{"p":"ride","v":"bodyHighBack","w":"settles"}],"shots":[{"focus":["ride","kit"],"width":0.94}]},{"s":"name","shows":{"p":"bagOutline","does":"a glowing outline traces the blue air bag"},"do":[{"p":"bagOutline","v":"show"}],"shots":[{"hero":true,"focus":["ride.bagF","bagOutline"],"width":0.35}]},{"s":"name2","shows":{"p":"kitOutline","does":"a glowing outline traces the pump, the tank and the valve beside the car"},"do":[{"p":"bagOutline","v":"hide"},{"p":"kitOutline","v":"show"}],"shots":[{"hero":true,"focus":["kit","ride.bagF","kitOutline"],"width":0.85}]},{"s":"how","shows":{"p":"ride","does":"air runs into the tank, the valve lamp lights, air runs down the hose and the car rises"},"do":[{"p":"kitOutline","v":"hide"},{"p":"kit","v":"fills","w":"fills"},{"p":"kit","v":"air","w":"opens"},{"p":"ride","v":"rise","w":"lifts"},{"p":"ride","v":"bodyRise","w":"lifts"}],"shots":[{"focus":["ride","kit"],"width":0.94}]},{"s":"fact","shows":{"p":"ride","does":"the raised car rides on its tall bags while yellow arrows push up and a gauge beside it counts to 2800"},"do":[{"p":"standA","v":"show"},{"p":"liftGauge","v":"show"},{"p":"liftArrows","v":"show"},{"p":"liftGauge","v":"count","o":-0.8,"d":1.2},{"p":"ride","v":"rise","w":"holds"},{"p":"ride","v":"bodyRise","w":"holds"}],"shots":[{"focus":["ride","liftGauge"],"width":0.94}]},{"s":"finish","shows":{"p":"kit","does":"a remote on a post appears with a red height button and its green pressure light comes on"},"do":[{"p":"liftGauge","v":"hide","w":"Add"},{"p":"liftArrows","v":"hide","w":"Add"},{"p":"ride","v":"riseBack","w":"Add"},{"p":"ride","v":"bodyRiseBack","w":"Add"},{"p":"kit","v":"remote","w":"button","autoW":{"w0":"remote"}},{"p":"kit","v":"light","w":"light","autoW":{"w0":"light","o0":-0.7}}],"shots":[{"focus":["ride"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":["ride","kit"],"width":0.9}]}],"audio":{"cards":[{"text":"4,000 POUNDS","at":{"s":"stakes","w":"4,000"},"d":1.5},{"text":"150-200 PSI","at":{"s":"fix2","w":"150"},"d":1.5},{"text":"2,800 POUNDS","at":{"s":"fact","w":"2,800"},"d":1.5}],"sfx":[{"lib":"drip","at":{"s":"problem","w":"leaks"},"d":1.2},{"lib":"motor_hum","at":{"s":"fix1","w":"compressor"},"d":2},{"lib":"water_rush","at":{"s":"problem3","w":"rushes"},"d":1.2},{"lib":"motor_hum","at":{"s":"how","w":"fills"},"d":1.5}],"chimes":[{"s":"stakes","w":"4,000"},{"s":"name"},{"s":"fact","w":"2,800"},{"s":"congrats"}]},"codeShots":true,"why":"A red car on a garage driveway, its body cut away low so the bags under it show, with the air kit (compressor, tank, valve, remote) building up beside it. The body visibly drops, lifts and shoots up on each line; shots frame the car and the kit together, close on the bag for its name.","hold":true},"sentences":[{"role":"hook","text":"If you swap a car's steel springs for rubber bags of air, you have air suspension."},{"role":"problem","text":"But a bag leaks and goes flat, and the car sags down onto its tires."},{"role":"stakes","text":"Now over 4,000 pounds of car press down on a flat bag that cannot hold it."},{"role":"fix1","text":"So you add a compressor that pumps air down a hose into the bag, and the car lifts."},{"role":"problem2","text":"But the little pump is slow, so after every bump the car sinks and stays low."},{"role":"fix2","text":"So you add a tank filled to about 150 to 200 pounds per square inch, and the bag refills in seconds."},{"role":"problem3","text":"But now the tank's air rushes in, the bag swells, and the car shoots up too high."},{"role":"fix3","text":"So you add a valve that lets air in or out, and the car settles at the right height."},{"role":"name","text":"This bag is called an air spring."},{"role":"name2","text":"And the bag, pump, tank and valve together are called air suspension."},{"role":"how","text":"The compressor fills the tank, the valve opens, and air lifts the car."},{"role":"fact","text":"At 100 pounds per square inch, a bag about six inches across holds roughly 2,800 pounds."},{"role":"finish","text":"Add a remote with a height button and a pressure light."},{"role":"congrats","text":"Congratulations, you have built a bagged car."}]}