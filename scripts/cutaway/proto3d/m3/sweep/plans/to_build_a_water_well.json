Flow","params":{"pipe":"link","count":6,"size":0.13,"speed":2,"dz":0.24,"mat":"water"}},{"id":"sign","kind":"sign","params":{"at":[4.7,0.08,-4],"rotY":0.22,"scale":1.3}}],"cues":[],"audio":{"cards":[{"text":"3,000 LB","at":{"s":"stakes","w":"3,000"},"d":1.8},{"text":"500 FEET","at":{"s":"problem2","w":"500"},"d":1.8}],"sfx":[{"lib":"dirt","at":{"s":"hook","w":"dig","o":0.05},"d":1.2},{"lib":"water_rush","at":{"s":"hook","w":"water"},"d":1.2},{"lib":"dirt","at":{"s":"problem","w":"walls"},"d":1.5},{"lib":"motor_hum","at":{"s":"fix2","w":"pump"},"d":2},{"lib":"drip","at":{"s":"problem3","w":"dirt"},"d":1.3},{"lib":"dirt","at":{"s":"fix3","w":"clay"},"d":1.2}],"chimes":[{"s":"stakes","w":"3,000"},{"s":"problem2","w":"500"},{"s":"name"},{"s":"name2"},{"s":"congrats"}],"rain":{"from":{"s":"problem3","w":"But"},"to":{"s":"fix3","w":"swells"},"underDb":24}},"codeShots":true,"why":"A water well in the yard, seen as a narrow shaft in section. The camera opens close on the digging, stays on the shaft as the walls cave in and the casing, pump, pipe and clay seal go in, shows counters beside the shaft and pipe, then pulls back to the calm home view for the cap and finishing touches.","hold":true,"beats":[{"s":"hook","shows":{"p":"dig","does":"the shaft is dug and water seeps in at the bottom"},"do":[{"p":"dig","v":"dig","o":-0.504},{"p":"wellWater","v":"flood","w":"water","d":1.2}],"shots":[{"focus":["dig"],"width":0.7}]},{"s":"problem","shows":{"p":"caveIn","does":"the bare walls cave in, soil falls down the shaft"},"state":{"text":"CAVE-IN","w":"walls"},"do":[{"p":"caveIn","v":"fall","w":"walls","d":2},{"p":"mud","v":"fall","w":"walls","o":0.3,"d":2}],"shots":[{"focus":["caveIn"],"width":0.7}]},{"s":"flood","shows":{"p":"mudFill","does":"mud fills the shaft metres deep over the water"},"state":{"text":"BURIED","w":"mud"},"do":[{"p":"mudFill","v":"flood","w":"mud","d":2.2}],"shots":[{"focus":["mudFill"],"width":0.7}]},{"s":"stakes","shows":{"p":"weightCounter","does":"a weight gauge beside the mud counts up to 3000 and turns red"},"state":{"text":"TOO HEAVY","w":"pounds"},"do":[{"p":"weightCounter","v":"show"},{"p":"weightCounter","v":"count","w":"weighs","d":2}],"shots":[{"focus":["mudFill","weightCounter"],"width":0.8}]},{"s":"fix1","shows":{"p":"casing","does":"a steel casing grows down the cleared shaft"},"do":[{"p":"mud","v":"hide","w":"So"},{"p":"caveIn","v":"hide","w":"So"},{"p":"mudFill","v":"hide","w":"So"},{"p":"weightCounter","v":"hide","w":"So"},{"p":"casing","v":"grow","w":"casing","d":2}],"shots":[{"focus":["casing"],"width":0.7}]},{"s":"name","shows":{"p":"casingOutline","does":"a glowing outline traces the casing"},"do":[{"p":"casingOutline","v":"show","w":"casing"}],"shots":[{"hero":true,"focus":["casing","casingOutline"],"width":0.5}]},{"s":"problem2","shows":{"p":"wellWater","does":"the water level drops far down at the bottom of the casing"},"state":{"text":"TOO DEEP","w":"feet"},"do":[{"p":"casingOutline","v":"hide","w":"But"},{"p":"wellWater","v":"drain","w":"But","o":0.2,"d":1}],"shots":[{"focus":["wellWater"],"width":0.7}]},{"s":"fix2","shows":{"p":"pump","does":"a pump pops in at the bottom and a thin pipe grows up to the top"},"do":[{"p":"pump","v":"show","w":"pump"},{"p":"wellWater","v":"flood","w":"pump","o":0.3,"d":1},{"p":"thinPipe","v":"grow","w":"pipe","d":1.6}],"shots":[{"focus":["pump"],"width":0.7},{"at":{"s":"fix2","w":"pipe"},"focus":["pump"],"width":0.7}]},{"s":"name2","shows":{"p":"pumpOutline","does":"a glowing outline traces the pump"},"do":[{"p":"pumpOutline","v":"show","w":"submersible"}],"shots":[{"hero":true,"focus":["pumpOutline"],"width":0.45}]},{"s":"how","shows":{"p":"thinFlow","does":"water dots run up the thin pipe, arrows point up"},"do":[{"p":"pumpOutline","v":"hide"},{"p":"pushArrows","v":"show","w":"pushes"},{"p":"thinFlow","v":"show","w":"water"}],"shots":[{"focus":["thinPipe","pump","thinFlow"],"width":0.8}]},{"s":"problem3","shows":{"p":"seepDirt","does":"rain runs down beside the casing, carrying dirt into the water"},"state":{"text":"DIRTY WATER","w":"dirt"},"do":[{"p":"famCounter","v":"show"},{"p":"famCounter","v":"count","d":2},{"p":"famCounter","v":"hide","w":"But"},{"p":"light","v":"storm","w":"But"},{"p":"rain","v":"start","w":"But"},{"p":"lawn","v":"wet","w":"But"},{"p":"puddles","v":"rise","w":"rain"},{"p":"rainArrows","v":"show","w":"down"},{"p":"seepDirt","v":"show","w":"dirt"},{"p":"leak","v":"murk","w":"dirt"}],"shots":[{"focus":["casing","seepDirt"],"width":0.8}]},{"s":"fix3","shows":{"p":"clay","does":"clay grows down both sides of the casing, the rain stops"},"do":[{"p":"rainArrows","v":"hide","w":"So"},{"p":"seepDirt","v":"hide","w":"So"},{"p":"clay","v":"grow","w":"clay","d":1.6,"ch":"chL"},{"p":"clay","v":"grow","w":"clay","d":1.6,"ch":"chR"},{"p":"rain","v":"stop","w":"swells"},{"p":"light","v":"clear","w":"swells"},{"p":"puddles","v":"dry","w":"swells","d":2.5},{"p":"lawn","v":"dry","w":"shut"},{"p":"leak","v":"clear1","w":"shut"},{"p":"leak","v":"clear2","w":"shut"}],"shots":[{"focus":["clay"],"width":0.7}]},{"s":"fix4","shows":{"p":"tank","does":"a blue pressure tank pops up beside the well and a pipe links it"},"do":[{"p":"tank","v":"show","w":"tank"},{"p":"link","v":"grow","w":"tank","o":0.3,"d":0.8},{"p":"linkFlow","v":"show","w":"water"}],"shots":[{"focus":["tank","link"],"width":0.8}]},{"s":"finish","shows":{"p":"cap","does":"a steel cap, a grass cap and bushes appear"},"do":[{"p":"cap","v":"show","w":"cap"},{"p":"grassL","v":"grow","w":"grass","d":0.9},{"p":"grassR","v":"grow","w":"grass","d":0.9},{"p":"bushes","v":"show","w":"bushes","o":-0.7}],"shots":[{"focus":["dig","cap","grassL","grassR","bushes"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","flood","stakes","fix1","name","problem2","fix2","name2","how","problem3","fix3","fix4","finish","congrats"]},"sentences":[{"role":"hook","text":"If you dig a deep, narrow shaft until water seeps in, you have a well."},{"role":"problem","text":"But the bare dirt walls cave in, and soil tumbles down the shaft."},{"role":"flood","text":"Wet mud fills the shaft and buries the water deep below."},{"role":"stakes","text":"A cubic yard of that soil weighs up to 3,000 pounds, as much as a small car."},{"role":"fix1","text":"So you clear the shaft and slide a steel casing down to hold the walls back."},{"role":"name","text":"This is a well casing."},{"role":"problem2","text":"But now the water is out of reach, and some wells go deeper than 500 feet."},{"role":"fix2","text":"So you drop a pump down and run a thin pipe up."},{"role":"name2","text":"This is a submersible pump, built to work underwater."},{"role":"how","text":"The pump pushes the water up the pipe, all the way to the surface."},{"role":"problem3","text":"But now the pump pulls hard, and storm rain runs down the casing, carrying dirt into the water."},{"role":"fix3","text":"So you pour clay around the casing, and it swells and holds the gap shut."},{"role":"fix4","text":"Then you add a pressure tank, so water waits at the top for your tap."},{"role":"finish","text":"Add a steel cap, a grass cap and bushes around the well."},{"role":"congrats","text":"Congratulations, you have built a water well."}]}