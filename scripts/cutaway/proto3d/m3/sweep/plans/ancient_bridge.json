at":{"s":"fix1","w":"piers"},"d":1},{"lib":"dirt","at":{"s":"fix2","w":"stones"},"d":1.2}],"chimes":[{"s":"name"},{"s":"how","w":"2000"},{"s":"congrats"}]},"codeShots":true,"why":"A ravine is dug in the ground with a river at the bottom, and the whole ancient-bridge story is built in section across it. A plank snaps under a cart, stone piers and flat slabs crack, and then a double stone arch on a wooden frame, with a keystone, saves the day. The camera opens close on the dug channel and the plank, stays mid on the span through the build, goes hero wide on the arch for the name, and ends on the home view with a cart rolling over the finished road.","hold":true,"beats":[{"s":"hook","shows":{"p":"plank","does":"dig the channel and lay a plank across"},"do":[{"p":"dig","v":"dig","d":1.6,"o":-1},{"p":"river","v":"flood","w":"channel","d":1.4},{"p":"plank","v":"show","w":"plank"}],"shots":[{"focus":["dig","plank"],"width":0.68}]},{"s":"problem","shows":{"p":"plank","does":"cart rolls on, plank snaps"},"state":{"text":"SNAPPED","w":"snaps"},"do":[{"p":"plank","v":"roll","w":"cart","d":1.5},{"p":"plank","v":"break","w":"snaps"}],"shots":[{"focus":["plank"],"width":0.94}]},{"s":"fix1","shows":{"p":"pier","does":"stone pier grows, slabs laid on top"},"do":[{"p":"plank","v":"hide","w":"So"},{"p":"pier","v":"grow","w":"piers","d":1,"ch":"pier"},{"p":"deck","v":"lay","w":"slabs"}],"shots":[{"focus":["pier","deck","plank"],"width":0.94}]},{"s":"problem2","shows":{"p":"deck","does":"a crack splits the slab"},"state":{"text":"CRACKED","w":"cracks"},"do":[{"p":"deck","v":"split","w":"cracks"}],"shots":[{"focus":["deck.deckL"],"width":0.55}]},{"s":"fix2","shows":{"p":"arch","does":"wooden frame, wedge stones, keystone go in"},"do":[{"p":"deck","v":"hide","w":"So"},{"p":"arch","v":"frame","w":"frame"},{"p":"arch","v":"s0","w":"stones"},{"p":"arch","v":"s1","w":"stones","o":0.5},{"p":"arch","v":"s2","w":"stones","o":1},{"p":"arch","v":"key","w":"keystone"}],"shots":[{"focus":["arch","plank"],"width":0.94}]},{"s":"name","shows":{"p":"archOutline","does":"glowing outline around the arch"},"do":[{"p":"archOutline","v":"show","w":"arch"}],"shots":[{"hero":true,"focus":["arch","archOutline","plank"],"width":0.94}]},{"s":"how","shows":{"p":"load","does":"block sits on the crown, arrows run down the curve"},"do":[{"p":"archOutline","v":"hide","w":"The"},{"p":"load","v":"set","w":"weight"},{"p":"thrust","v":"show","w":"squeezes"}],"shots":[{"focus":["arch","load","plank"],"width":0.94}]},{"s":"fix3","shows":{"p":"arch","does":"wooden frame pulled away, arch stands alone"},"do":[{"p":"thrust","v":"hide","w":"So"},{"p":"load","v":"setBack","w":"So"},{"p":"arch","v":"frameBack","w":"frame"}],"shots":[{"focus":["arch","plank"],"width":0.94}]},{"s":"finish","shows":{"p":"bridgeTop","does":"road and walls grow over the arches, a cart rolls across"},"do":[{"p":"brickArch","v":"bk0"},{"p":"brickArch","v":"bk1"},{"p":"brickArch","v":"bkey"},{"p":"brickArch","v":"hide","w":"Add"},{"p":"bridgeTop","v":"grow","w":"road","d":1,"ch":"road"},{"p":"bridgeTop","v":"grow","w":"walls","d":1,"ch":"wallF"},{"p":"bridgeTop","v":"grow","w":"walls","o":0.2,"d":1,"ch":"wallB"},{"p":"cart2","v":"arrive","w":"cart"},{"p":"cart2","v":"roll","w":"cart","d":3,"o":-0.7}],"shots":[{"focus":["plank","bridgeTop","cart2"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","fix1","problem2","fix2","name","how","fix3","finish","congrats"]},"sentences":[{"role":"hook","text":"If you dig a channel and lay a plank across, you have a bridge."},{"role":"problem","text":"But a cart loaded with stone rolls on and the plank snaps."},{"role":"fix1","text":"So you build stone piers in the river and rest flat slabs on top."},{"role":"problem2","text":"But stone is typically about 10 to 20 times stronger in compression than in tension, so a long slab cracks underneath."},{"role":"fix2","text":"So you set a wooden frame, curve wedge stones over it, and lock the top with a keystone."},{"role":"name","text":"This is an arch bridge."},{"role":"how","text":"The weight squeezes the stones down the curve into the piers, so the Pons Fabricius carries walkers after more than 2000 years."},{"role":"fix3","text":"So you pull the frame away, and the arch holds itself, as at Alcántara, where granite blocks sit without mortar."},{"role":"finish","text":"Add a stone road and low walls over the arches, and a cart rolls across."},{"role":"congrats","text":"Congratulations, you have built an arch bridge."}]}