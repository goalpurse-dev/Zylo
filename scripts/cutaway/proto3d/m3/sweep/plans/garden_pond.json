w":"5"},"d":1.8}],"sfx":[{"lib":"dirt","at":{"s":"hook","w":"dig","o":0.05},"d":1.2},{"lib":"drip","at":{"s":"problem","w":"soaks"},"d":1.3},{"lib":"water_rush","at":{"s":"fix1","w":"fill"},"d":1.4},{"lib":"water_rush","at":{"s":"problem2","w":"spills"},"d":1.4},{"lib":"motor_hum","at":{"s":"fix3","w":"pump"},"d":1.6}],"chimes":[{"s":"name"},{"s":"fact","w":"5"},{"s":"congrats"}],"rain":{"from":{"s":"problem2","w":"But"},"to":{"s":"name2","w":"soak"},"underDb":24}},"codeShots":true,"why":"A garden pond in a park setting, dug as a box cut so its liner, water, pipes and fish show in section. The camera opens close on the digging, watches the water soak away and the liner hold it, pulls wider for the storm spill and the overflow to the soak pit, then stays on the water as it turns green, the pump clears it, fish appear, and ends on the calm home view with rocks and lily pads.","hold":true},"sentences":[{"role":"hook","text":"If you dig a hole in the lawn and pour in water, you have a pond."},{"role":"problem","text":"But the water soaks away through the loose soil, and the hole is dry again."},{"role":"fix1","text":"So you line the floor and walls with a liner, and the pond can fill."},{"role":"name","text":"This is a garden pond."},{"role":"problem2","text":"But now the liner holds every drop, so a storm fills it past the brim and it spills."},{"role":"flood","text":"The puddles spread across the lawn all around the pond."},{"role":"fix2","text":"So you run a pipe from the brim down to a gravel pit."},{"role":"name2","text":"That pipe is an overflow, and the gravel pit is a soak pit."},{"role":"problem3","text":"But now the full pond sits still in the warm sun, and the water turns green."},{"role":"fix3","text":"So you set a pump beside the pond."},{"role":"fix4","text":"So you run a pipe from the pond wall to the pump."},{"role":"how","text":"The pump pulls water through the pipe and sprays it back, and the pond clears."},{"role":"fact","text":"Moving water adds oxygen, and most pond fish need about 3 to 5 milligrams per liter."},{"role":"factProof","text":"Now fish can swim and breathe in the clear water."},{"role":"myth","text":"And the goldfish memory of three seconds is not real."},{"role":"mythFact","text":"Tests show goldfish remember things for months."},{"role":"finish","text":"Add rocks round the edge, lily pads and bushes."},{"role":"congrats","text":"Congratulations, you have built a garden pond."}]}