ox shots to hold the whole plane in frame.","hold":true,"beats":[{"s":"hook","shows":{"p":"plane","does":"wings pop onto the tube"},"do":[{"p":"plane","v":"show"},{"p":"plane","v":"wingsOn","w":"wings"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"problem","shows":{"p":"plane","does":"wheels spin on the runway but the plane stays pinned under yellow weight arrows"},"state":{"text":"STUCK","w":"sits"},"do":[{"p":"weight","v":"show","w":"sits"},{"p":"plane","v":"rollWheels","w":"sits"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"stakes","shows":{"p":"wCount","does":"weight counter ticks up to 1100 and its bar fills red"},"state":{"text":"TOO HEAVY","w":"weighs"},"do":[{"p":"plane","v":"rollWheelsBack","w":"weighs"},{"p":"pole1","v":"show","w":"weighs"},{"p":"wCount","v":"show","w":"weighs"},{"p":"wCount","v":"count","w":"weighs","d":2.2}],"shots":[{"focus":["plane","wCount"],"width":0.94}]},{"s":"fix1","shows":{"p":"plane","does":"engine pops on, propeller spins, air streams straight past the flat wing"},"do":[{"p":"wCount","v":"hide","w":"So"},{"p":"weight","v":"hide","w":"So"},{"p":"plane","v":"engineOn","w":"engine"},{"p":"plane","v":"spinProp","w":"propeller"},{"p":"airFlat","v":"show","w":"air"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"fix2","shows":{"p":"plane","does":"wing top bulges, fast air arrows run over it, yellow lift arrows rise"},"do":[{"p":"airFlat","v":"hide","w":"So"},{"p":"plane","v":"curve","w":"curve"},{"p":"airFast","v":"show","w":"speeds"},{"p":"lift","v":"show","w":"lifts"}],"shots":[{"focus":["plane.wing"],"width":0.55}]},{"s":"fix3","shows":{"p":"plane","does":"fin and stabilizer pop onto the tail"},"do":[{"p":"airFast","v":"hide","w":"So"},{"p":"lift","v":"hide","w":"So"},{"p":"plane","v":"tailOn","w":"tail"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"fix4","shows":{"p":"plane","does":"rudder and elevator swing on their hinges"},"do":[{"p":"plane","v":"elevate","w":"up"},{"p":"plane","v":"steer","w":"sideways"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"name","shows":{"p":"planeOutline","does":"yellow outline traces the whole plane"},"do":[{"p":"plane","v":"steerBack"},{"p":"planeOutline","v":"show","w":"airplane"}],"shots":[{"hero":true,"focus":["plane","planeOutline"],"width":0.94}]},{"s":"name2","shows":{"p":"wingOutline","does":"yellow outline traces the curved wing"},"do":[{"p":"planeOutline","v":"hide","w":"airfoil"},{"p":"wingOutline","v":"show","w":"airfoil"}],"shots":[{"focus":["plane.wing","wingOutline"],"width":0.8}]},{"s":"how","shows":{"p":"plane","does":"wheels spin, the plane rolls down the runway and climbs off it while the speed counter ticks to 100"},"do":[{"p":"wingOutline","v":"hide","w":"At"},{"p":"pole2","v":"show","w":"At"},{"p":"speed","v":"show","w":"At"},{"p":"speed","v":"count","w":"At","d":4.2},{"p":"plane","v":"rollWheels","w":"At"},{"p":"plane","v":"takeoff","w":"At","d":6}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"problem2","shows":{"p":"plane","does":"a gust pushes down one wing and the plane tips onto its side in the air"},"state":{"text":"ROLLING","w":"tips"},"do":[{"p":"speed","v":"hide","w":"But"},{"p":"gustArrows","v":"show","w":"gust"},{"p":"plane","v":"gust","w":"tips"}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"problem3","shows":{"p":"landSpeed","does":"speed gauge climbs and turns red while the tipped plane is still aloft"},"state":{"text":"TOO FAST","w":"land"},"do":[{"p":"landSpeed","v":"show","w":"land"},{"p":"landSpeed","v":"count","w":"land","d":3}],"shots":[{"focus":["landSpeed","plane"],"width":0.94}]},{"s":"fix5","shows":{"p":"plane","does":"flaps pop on and tilt down, the plane levels out and settles back onto the runway"},"do":[{"p":"landSpeed","v":"hide","w":"So"},{"p":"gustArrows","v":"hide","w":"So"},{"p":"plane","v":"flapsOn","w":"flaps"},{"p":"plane","v":"gustBack","w":"level"},{"p":"plane","v":"flaps","w":"slow"},{"p":"plane","v":"takeoffBack","w":"slow","o":0.2,"d":5.5},{"p":"plane","v":"elevateBack","w":"slow","o":0.2}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"finish","shows":{"p":"stairs","does":"door and windows pop onto the fuselage and stairs appear beside it"},"do":[{"p":"airFast","v":"show"},{"p":"lift","v":"show"},{"p":"gCount","v":"show"},{"p":"gCount","v":"count","d":2.5},{"p":"plane","v":"spinPropBack"},{"p":"airFast","v":"hide","w":"Add"},{"p":"lift","v":"hide","w":"Add"},{"p":"gCount","v":"hide","w":"Add"},{"p":"plane","v":"rollWheelsBack","w":"Add"},{"p":"plane","v":"flapsBack","w":"Add"},{"p":"plane","v":"doorOn","w":"door"},{"p":"plane","v":"windowsOn","w":"windows"},{"p":"stairs","v":"show","w":"stairs","o":-0.7}],"shots":[{"focus":["plane","stairs"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","stakes","fix1","fix2","fix3","fix4","name","name2","how","problem2","problem3","fix5","finish","congrats"]},"sentences":[{"role":"hook","text":"If you bolt two wings onto a tube, you have an airplane."},{"role":"problem","text":"But the flat wings give no lift, so the wheels turn and the plane sits on the runway."},{"role":"stakes","text":"A Cessna 172 weighs about 2,450 pounds, and gravity pins every pound of it down."},{"role":"fix1","text":"So you add an engine and a propeller that push air past the wings, but flat wings let the air slide by."},{"role":"fix2","text":"So you curve the top of the wing, and the air speeds up over it and the wing lifts."},{"role":"fix3","text":"But now the nose wanders, so you add a tail with a fin and stabilizer that hold the nose pointing straight."},{"role":"fix4","text":"Then you hinge the back of the tail, so the rudder swings the nose sideways and the elevator swings it up."},{"role":"name","text":"This is an airplane."},{"role":"name2","text":"The curved wing shape is called an airfoil."},{"role":"how","text":"At about 100 kilometers per hour, the air over the wings lifts the plane off the runway."},{"role":"problem2","text":"But a gust of wind pushes one wing down, and the plane tips onto its side."},{"role":"problem3","text":"And to land, the plane must slow down, but at 100 kilometers per hour it is far too fast."},{"role":"fix5","text":"So you add flaps on the wings that level the plane and slow it until it settles onto the runway."},{"role":"finish","text":"Add a door, windows and stairs so people can board."},{"role":"congrats","text":"Congratulations, you have built an airplane."}]}