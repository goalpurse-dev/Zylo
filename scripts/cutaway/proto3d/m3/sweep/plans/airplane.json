ole2","v":"show","w":"And"},{"p":"landSpeed","v":"show","w":"And"},{"p":"landSpeed","v":"count","o":-0.6,"d":1.2},{"p":"plane","v":"gust","w":"fast"}],"shots":[{"focus":["plane","landSpeed"],"width":0.94}]},{"s":"fix5","shows":{"p":"plane","does":"flaps appear and tilt down, the plane levels out and settles back onto the runway"},"do":[{"p":"landSpeed","v":"hide","w":"So"},{"p":"gustArrows","v":"hide","w":"So"},{"p":"plane","v":"flapsOn","w":"flaps"},{"p":"plane","v":"gustBack","w":"level"},{"p":"plane","v":"flaps","w":"slow"},{"p":"plane","v":"takeoffBack","w":"slow","o":0.2,"d":4}],"shots":[{"focus":["plane"],"width":0.94}]},{"s":"finish","shows":{"p":"boardPoint","does":"a blue door and big windows pop onto the fuselage and stairs appear under the door"},"do":[{"p":"plane","v":"spinPropBack","w":"Add"},{"p":"plane","v":"rollWheelsBack","w":"Add"},{"p":"plane","v":"flapsBack","w":"Add"},{"p":"plane","v":"doorOn","w":"door"},{"p":"boardPoint","v":"show","w":"Add"},{"p":"plane","v":"windowsOn","w":"windows"},{"p":"stairs","v":"show","w":"board","autoW":{"w0":"stairs","o0":-0.7}}],"shots":[{"focus":["plane","stairs"],"width":0.85}]},{"s":"congrats","do":[{"p":"boardPoint","v":"hide"}],"shots":[{"focus":["plane"],"width":0.9}]}],"audio":{"cards":[{"text":"2,450 POUNDS","at":{"s":"stakes","w":"2,450"},"d":1.5},{"text":"100 KILOMETERS","at":{"s":"how","w":"100"},"d":1.5}],"sfx":[{"lib":"motor_hum","at":{"s":"fix1","w":"engine"},"d":2},{"lib":"motor_hum","at":{"s":"how","o":0.2},"d":2.5},{"lib":"water_rush","at":{"s":"problem2","w":"gust"},"d":1.2}],"chimes":[{"s":"stakes","w":"2,450"},{"s":"name"},{"s":"how","w":"100"},{"s":"congrats"}]},"codeShots":true,"why":"A white plane on an asphalt runway in an open field, built up piece by piece (wings, engine, curved wing, tail, hinged rudder and elevator, flaps, door). Close shots on the engine, wing and tail when they change, the whole plane for take-off and the outlines from the first word of their lines.","hold":true},"sentences":[{"role":"hook","text":"If you bolt two wings onto a tube, you have an airplane."},{"role":"problem","text":"But the flat wings give no lift, so the wheels turn and the plane sits on the runway."},{"role":"stakes","text":"An older Cessna 172 weighs about 2,450 pounds, and gravity pins every pound of it down."},{"role":"fix1","text":"So you add an engine and a propeller, but the air just slides past the flat wings."},{"role":"fix2","text":"So you curve the top of the wing, and the air speeds up over it and the wing lifts."},{"role":"fix3","text":"But now the nose wanders, so you add a tail with a fin and a stabilizer that hold the nose pointing straight."},{"role":"fix4","text":"Then you hinge the back of the tail, so the rudder swings the nose sideways and the elevator tilts it up."},{"role":"name","text":"This is an airplane."},{"role":"name2","text":"The curved wing shape is called an airfoil."},{"role":"how","text":"At about 100 kilometers per hour, the air over the wings lifts the plane off the runway."},{"role":"problem2","text":"But a gust of wind pushes one wing down, and the plane tips onto its side."},{"role":"problem3","text":"And to land, the plane must slow down, but at 100 kilometers per hour it is far too fast."},{"role":"fix5","text":"So you add flaps on the wings that level the plane and slow it until it settles onto the runway."},{"role":"finish","text":"Add a door, windows and stairs so people can board."},{"role":"congrats","text":"Congratulations, you have built an airplane."}]}