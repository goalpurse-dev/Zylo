","rawOut"],"width":0.94}]},{"s":"finish","shows":{"p":"fence","does":"a fence and young trees pop up round the plant"},"do":[{"p":"gallons","v":"hide","w":"Add"},{"p":"sludgeFlow","v":"hide","w":"Add"},{"p":"fence","v":"show","w":"fence"},{"p":"trees","v":"show","w":"plant","autoW":{"w0":"trees","o0":-0.7}},{"p":"bubbles","v":"hide","w":"Add"},{"p":"outFlow","v":"hide","w":"Add"},{"p":"outPipeOutfall","v":"stop","w":"Add","o":0.4}],"shots":[{"focus":["rawOut","fence","trees"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"audio":{"cards":[{"text":"65%","at":{"s":"problem2","w":"65"},"d":1.5},{"text":"82 GALLONS","at":{"s":"fact","w":"82"},"d":1.6}],"sfx":[{"lib":"water_rush","at":{"s":"hook","w":"river"},"d":1.4},{"lib":"water_rush","at":{"s":"fix1","w":"tank","o":0.2},"d":1.4},{"lib":"motor_hum","at":{"s":"fix2","w":"air"},"d":1.6},{"lib":"drip","at":{"s":"problem3","w":"sludge"},"d":1.2},{"lib":"flame","at":{"s":"fix3","w":"gas"},"d":1.4}],"chimes":[{"s":"problem2","w":"65"},{"s":"name"},{"s":"fact","w":"82"},{"s":"congrats"}]},"codeShots":true,"why":"A small sewage works beside a park creek, built in the ground in section: the town's sewer pipe runs under the cut to the creek, then a settling tank and an aeration tank go into the cut, clean water returns to the creek, and the sludge goes to a digester whose gas burns as a flare. The camera opens close on the pipe pouring into the creek, follows the tanks in mid shots, and ends wide on the fenced plant.","hold":true},"sentences":[{"role":"hook","text":"If you pipe a town's toilets straight into a river, you have a sewer."},{"role":"problem","text":"But the river turns dark brown and stinks."},{"role":"fix1","text":"So you fill a tank, where solids sink and scum floats."},{"role":"problem2","text":"But now it catches only 45 to 65 of every 100 bits of waste, so the water stays dark."},{"role":"fix2","text":"So you add a tank and blow in air for bacteria."},{"role":"name","text":"This is a sewage treatment plant."},{"role":"how","text":"Bacteria eat the rest, and clear water flows to the river."},{"role":"problem3","text":"But now sludge piles up on the floor."},{"role":"fix3","text":"So you pump it to a digester, and its gas burns."},{"role":"fact","text":"The average American sends about 82 gallons a day."},{"role":"finish","text":"Add a fence and young trees around the plant."},{"role":"congrats","text":"Congratulations, you have built a sewage treatment plant."}]}