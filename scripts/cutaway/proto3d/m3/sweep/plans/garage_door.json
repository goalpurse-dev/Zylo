,"w":"So"},{"p":"rainFlow","v":"stop","w":"So"},{"p":"panel","v":"show","w":"panel"},{"p":"floodWater","v":"drain","w":"hinges"}],"shots":[{"focus":["panel"],"width":0.7}]},{"s":"problem2","shows":{"p":"panel","does":"the panel swings out into the car on the driveway"},"state":{"text":"SMASHED","w":"smashes"},"do":[{"p":"car2","v":"arrive","w":"But"},{"p":"panel","v":"swingOut","w":"swings","d":1.2}],"shots":[{"focus":["panel","car2"],"width":0.8}]},{"s":"fix2","shows":{"p":"door","does":"hinged sections appear and roll up the rails"},"do":[{"p":"car2","v":"leave","w":"split"},{"p":"panel","v":"hide","w":"split"},{"p":"door","v":"show","w":"split"},{"p":"door","v":"railsIn","w":"sections"},{"p":"door","v":"secsIn","w":"sections","o":0.3},{"p":"door","v":"roll","w":"rails","d":2}],"shots":[{"focus":["door"],"width":0.7}]},{"s":"name","shows":{"p":"doorOutline","does":"the door rolls down and a glowing outline traces it"},"do":[{"p":"door","v":"rollBack","d":1.2},{"p":"doorOutline","v":"show","w":"sectional"}],"shots":[{"hero":true,"focus":["door","doorOutline"],"width":0.9}]},{"s":"how","shows":{"p":"door","does":"the sections ride the rails up and back under the ceiling"},"do":[{"p":"doorOutline","v":"hide","w":"Rollers"},{"p":"door","v":"roll","w":"ride","d":2.2}],"shots":[{"focus":["door.rails"],"width":0.55}]},{"s":"problem3","shows":{"p":"door","does":"the heavy door drops and slams down to the floor"},"state":{"text":"TOO HEAVY","w":"heavy"},"do":[{"p":"crashArrows","v":"show","w":"heavy"},{"p":"door","v":"rollBack","d":0.5}],"shots":[{"focus":["door"],"width":0.7}]},{"s":"fact","shows":{"p":"weight","does":"a weight gauge beside the door climbs to 250"},"do":[{"p":"crashArrows","v":"hide","w":"A"},{"p":"weight","v":"show","w":"door"},{"p":"weight","v":"count","w":"weigh","d":2}],"shots":[{"focus":["weight","door"],"width":0.8}]},{"s":"fix3","shows":{"p":"door","does":"a steel spring appears over the door and the door lifts smoothly"},"do":[{"p":"weight","v":"hide","w":"So"},{"p":"door","v":"springIn","w":"spring"},{"p":"door","v":"roll","w":"balances","d":2}],"shots":[{"focus":["door.spring"],"width":0.55}]},{"s":"name2","shows":{"p":"springOutline","does":"a glowing outline traces the spring over the door"},"do":[{"p":"springOutline","v":"show","w":"torsion"}],"shots":[{"hero":true,"focus":["door.spring","springOutline"],"width":0.5}]},{"s":"fix4","shows":{"p":"door","does":"two sensors appear at the bottom of the opening and a red beam lights between them"},"do":[{"p":"cycles","v":"show"},{"p":"cycles","v":"count","d":2},{"p":"cycles","v":"hide","w":"So"},{"p":"door","v":"eyesIn","w":"beam"},{"p":"door","v":"beamOn","w":"beam","o":0.3}],"shots":[{"focus":["door.eyes"],"width":0.55}]},{"s":"myth","shows":{"p":"door","does":"the opener motor appears blinking, then gets a red cross"},"do":[{"p":"door","v":"motorIn","w":"motor"},{"p":"door","v":"motorOn","w":"motor","o":0.2},{"p":"door","v":"crossIn","w":"not"}],"shots":[{"focus":["door.motor"],"width":0.55}]},{"s":"mythFact","shows":{"p":"door","does":"the spring winds as the door rolls closed, yellow arrows point up"},"do":[{"p":"door","v":"motorOnBack","w":"spring"},{"p":"door","v":"wind","w":"spring"},{"p":"liftArrows","v":"show","w":"twisting"},{"p":"door","v":"rollBack","w":"closes","d":2}],"shots":[{"focus":["door"],"width":0.7}]},{"s":"finish","shows":{"p":"homeCar","does":"the door opens, a rubber seal appears along the bottom and the car rolls inside"},"do":[{"p":"door","v":"windBack","w":"Add"},{"p":"liftArrows","v":"hide","w":"Add"},{"p":"door","v":"crossInBack","w":"Add"},{"p":"door","v":"roll","w":"Add","d":1.5},{"p":"door","v":"sealIn"},{"p":"homeCar","v":"arrive","d":2}],"shots":[{"focus":["opening","homeCar"],"width":0.85}]},{"s":"congrats","shows":{"p":"door","does":"the door rolls down behind the parked car"},"do":[{"p":"door","v":"rollBack","w":"Congratulations","d":2.2}],"shots":[]}],"roles":["hook","problem","fix1","problem2","fix2","name","how","problem3","fact","fix3","name2","fix4","myth","mythFact","finish","congrats"]},"sentences":[{"role":"hook","text":"If you cut a wide hole in a garage wall, you have a garage door."},{"role":"problem","text":"But rain blows in through the open hole and soaks the concrete floor."},{"role":"fix1","text":"So you hang a big panel on hinges to close the hole."},{"role":"problem2","text":"But now the panel swings out and smashes the car in the driveway."},{"role":"fix2","text":"So you split the panel into hinged sections that roll up rails."},{"role":"name","text":"This is a sectional door."},{"role":"how","text":"Rollers on each section ride the rails up and back under the ceiling."},{"role":"problem3","text":"But now the heavy sections come down to the floor with nothing holding them."},{"role":"fact","text":"A double door like this can weigh 150 to 250 pounds."},{"role":"fix3","text":"So you mount a steel spring above the opening that balances the door's weight."},{"role":"name2","text":"This is a torsion spring."},{"role":"fix4","text":"So you add a safety beam, required on new openers in America since 1993."},{"role":"myth","text":"And the motor on the ceiling is not what lifts the door."},{"role":"mythFact","text":"The spring does, twisting tight as the door closes to store its weight."},{"role":"finish","text":"Add a car rolling into the open garage."},{"role":"congrats","text":"Congratulations, you have built a garage door."}]}