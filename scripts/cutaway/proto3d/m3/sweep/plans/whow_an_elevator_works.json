t","kind":"outline","params":{"points":[[0.7,3.8,-3.2],[1.3,3.8,-3.2],[1.3,4.5,-3.2],[0.7,4.5,-3.2]],"opts":{"r":0.03,"closed":true}}},{"id":"weights","kind":"arrows","params":{"list":[{"at":[0,4.9,-2],"dir":[0,-1],"travel":1,"phase":0},{"at":[1.45,2.9,-2],"dir":[0,-1],"travel":1,"phase":0}],"opts":{"scale":1.2,"color":"#ffd23d"}}},{"id":"sign","kind":"sign","params":{"at":[19.9,0.12,-1.5],"rotY":-0.2,"scale":1}}],"cues":[],"audio":{"cards":[{"text":"1,000 KG","at":{"s":"problem","w":"thousand"},"d":1.8},{"text":"40%","at":{"s":"fact"},"d":1.6}],"sfx":[{"lib":"motor_hum","at":{"s":"hook","w":"pull"},"d":1.6},{"lib":"motor_hum","at":{"s":"how","w":"turns"},"d":1.8},{"lib":"motor_hum","at":{"s":"finish","w":"Add"},"d":1.8}],"chimes":[{"s":"problem","w":"thousand"},{"s":"name"},{"s":"fact"},{"s":"name2"},{"s":"congrats"}]},"codeShots":true,"why":"A traction elevator shown whole in a room-backdrop shaft: rope, wheel, motor, counterweight, rails, safety gear and car are one rig, and the camera frames it from the home angle, with close shots for the clamp and the ropes. The error is fixed by giving the rope extend moves their own name (ropeRise), so the name rise is a slide on every node that uses it. Each beat that raised or lowered the car now also calls ropeRise.","hold":true,"beats":[{"s":"hook","shows":{"p":"lift","does":"car rises on a rope over the wheel"},"do":[{"p":"dig","v":"dig"},{"p":"lift","v":"show"},{"p":"lift","v":"rise","w":"pull"},{"p":"lift","v":"ropeRise","w":"pull"},{"p":"lift","v":"turn","w":"pull"}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"problem","shows":{"p":"load","does":"load gauge climbs into the red"},"state":{"text":"TOO HEAVY","w":"weighs"},"do":[{"p":"lift","v":"turnBack","w":"But"},{"p":"load","v":"show","w":"But"},{"p":"load","v":"count","w":"weighs","d":2.5}],"shots":[{"focus":["lift.motor","load"],"width":0.8}]},{"s":"stakes","shows":{"p":"lift","does":"car sinks back to the floor"},"state":{"text":"STALLED","w":"stalls"},"do":[{"p":"lift","v":"riseBack","w":"sinks"},{"p":"lift","v":"ropeRiseBack","w":"sinks"}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"fix1","shows":{"p":"lift","does":"counterweight appears and the load gauge falls"},"do":[{"p":"lift","v":"hang","w":"counterweight"},{"p":"load","v":"hide","w":"counterweight"},{"p":"load2","v":"show","w":"counterweight"},{"p":"load2","v":"count","w":"counterweight","d":3}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"name","shows":{"p":"tOut","does":"outline traces the whole elevator"},"do":[{"p":"tOut","v":"show","w":"traction"}],"shots":[{"hero":true,"focus":["lift","tOut"],"width":0.94}]},{"s":"how","shows":{"p":"lift","does":"wheel turns, car rises while counterweight sinks"},"do":[{"p":"tOut","v":"hide"},{"p":"lift","v":"rise","w":"turns"},{"p":"lift","v":"ropeRise","w":"turns"},{"p":"lift","v":"turn","w":"turns"}],"shots":[{"focus":["lift.sheave","lift.car"],"width":0.8,"zone":"center"}]},{"s":"fact","shows":{"p":"weights","does":"equal weight arrows on car and counterweight"},"do":[{"p":"weights","v":"show","w":"weighs"}],"shots":[{"focus":["lift","weights"],"width":0.94}]},{"s":"problem2","shows":{"p":"lift","does":"car and counterweight swing loose"},"state":{"text":"SWAYING","w":"swing"},"do":[{"p":"weights","v":"hide","w":"But"},{"p":"lift","v":"turnBack","w":"But"},{"p":"lift","v":"sway","w":"swing"}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"fix2","shows":{"p":"lift","does":"steel rails go up and the car straightens"},"do":[{"p":"lift","v":"bolt","w":"rails"},{"p":"lift","v":"swayBack","w":"rails"}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"problem3","shows":{"p":"lift","does":"rope snaps and the car plunges"},"state":{"text":"FALLING","w":"falling"},"do":[{"p":"lift","v":"snap","w":"snaps"},{"p":"lift","v":"drop","w":"snaps","o":0.5}],"shots":[{"focus":["lift"],"width":0.94}]},{"s":"fix3","shows":{"p":"lift","does":"rope mended, car back up, clamps appear on the rails"},"do":[{"p":"lift","v":"snapBack","w":"So"},{"p":"lift","v":"dropBack","w":"So"},{"p":"lift","v":"clamp","w":"clamp"}],"shots":[{"focus":["lift.car","lift.gear"],"width":0.8,"zone":"center"}]},{"s":"name2","shows":{"p":"gOut","does":"outline on the blinking clamp"},"do":[{"p":"gOut","v":"show","w":"safety"},{"p":"lift","v":"grip","w":"safety"}],"shots":[{"hero":true,"focus":["lift.gear","gOut"],"width":0.4}]},{"s":"finish","shows":{"p":"lift","does":"doors, button panel and ceiling light added as the car glides down"},"do":[{"p":"lift","v":"markBack"},{"p":"lift","v":"ropes"},{"p":"lift","v":"gripBack"},{"p":"lift","v":"mark"},{"p":"lift","v":"riseBack","w":"Add"},{"p":"lift","v":"ropeRiseBack","w":"Add"},{"p":"lift","v":"turnDown","w":"Add"},{"p":"lift","v":"doors","w":"doors"},{"p":"lift","v":"open","w":"doors","o":1.4},{"p":"lift","v":"buttons","w":"button"},{"p":"lift","v":"fixture","w":"light"},{"p":"lift","v":"glow","w":"light","o":-0.7}],"shots":[{"focus":["lift"],"width":0.85}]},{"s":"congrats","shows":{"p":"lift","does":"calm car at the floor with doors open"},"do":[{"p":"lift","v":"turnDownBack","w":"Congratulations"},{"p":"lift","v":"press","w":"Congratulations"}],"shots":[{"focus":"home"}]}],"roles":["hook","problem","stakes","fix1","name","how","fact","problem2","fix2","problem3","fix3","name2","finish","congrats"]},"sentences":[{"role":"hook","text":"If you pull a box up on a rope over a wheel, you have an elevator."},{"role":"problem","text":"But a full car weighs about a thousand kilograms, and the motor alone has to lift all of it."},{"role":"stakes","text":"So the motor stalls, and the car sinks back down to the floor."},{"role":"fix1","text":"So you hang a counterweight on the other end of the rope, and the motor lifts only the difference."},{"role":"name","text":"This is a traction elevator."},{"role":"how","text":"The motor turns a grooved wheel, the ropes grip it, and the car rises as the counterweight sinks."},{"role":"fact","text":"The counterweight usually weighs as much as the car plus about 40 to 50 percent of its rated load, so the two nearly balance."},{"role":"problem2","text":"But the light car and the counterweight now swing loose in the shaft."},{"role":"fix2","text":"So you bolt steel rails up the shaft, and the car rides on the rails and stops swinging."},{"role":"problem3","text":"But if a rope snaps, nothing stops the car from falling."},{"role":"fix3","text":"So you add a safety clamp that grips the rails, the trick Elisha Otis showed in 1854."},{"role":"name2","text":"This is a safety gear."},{"role":"finish","text":"Add sliding doors, a button panel and a ceiling light, and the car glides down to the floor."},{"role":"congrats","text":"Congratulations, you have built an elevator."}]}