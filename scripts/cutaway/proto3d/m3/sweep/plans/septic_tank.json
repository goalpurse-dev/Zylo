kOutline","v":"show","w":"septic"}],"shots":[{"hero":true,"focus":["tank","tankOutline","dig"],"width":0.68}]},{"s":"fact","shows":{"p":"years","does":"a years counter ticks up beside the tank as sludge piles higher"},"do":[{"p":"tankOutline","v":"hide","w":"Sludge"},{"p":"tank","v":"sink","w":"Sludge"},{"p":"stand","v":"show","w":"pumped"},{"p":"years","v":"show","w":"pumped"},{"p":"years","v":"count","w":"every","d":2.2}],"shots":[{"focus":["tank","years","dig"],"width":0.68}]},{"s":"finish","shows":{"p":"capGrass","does":"a riser lid pops up and grass covers the tank"},"do":[{"p":"years","v":"hide","w":"Add"},{"p":"soakArrows","v":"hide","w":"Add"},{"p":"soak","v":"hide","w":"Add"},{"p":"fieldFlow","v":"hide","w":"Add"},{"p":"outletFlow","v":"hide","w":"Add"},{"p":"inletFlow","v":"hide","w":"Add"},{"p":"riser","v":"grow","w":"lid"},{"p":"lid","v":"show","w":"grass","autoW":{"w0":"lid","o0":0.3}},{"p":"dig","v":"refill","w":"grass"},{"p":"capSoil","v":"grow","w":"grass"},{"p":"capGrass","v":"grow","w":"grass","d":0.9,"autoW":{"w0":"grass","o0":-0.7}}],"shots":[{"focus":["dig","riser","lid","capSoil","capGrass"],"width":0.85}]},{"s":"congrats","shows":{"p":"capGrass","does":"calm lawn over the tank with its lid and the drain field"},"do":[],"shots":[{"focus":"home"}]}],"audio":{"cards":[{"text":"3-5 YEARS","at":{"s":"fact","w":"3"},"d":1.8}],"sfx":[{"lib":"dirt","at":{"s":"hook","w":"dig","o":0.05},"d":1.2},{"lib":"water_rush","at":{"s":"problem","w":"fills"},"d":1.4},{"lib":"drip","at":{"s":"fix1","w":"sink"},"d":1.3},{"lib":"water_rush","at":{"s":"fix2","w":"clear"},"d":1.3},{"lib":"dirt","at":{"s":"fix3","w":"gravel"},"d":1.2}],"chimes":[{"s":"fact","w":"3"},{"s":"name"},{"s":"congrats"}]},"codeShots":true,"why":"A septic tank in the yard: a pit is dug beside the house and the toilet pipe runs into it; it overflows, so a concrete tank in section separates sludge (sinks) and scum (floats), a T outlet sends the clear middle water out, and a gravel drain field soaks it away. The camera opens close on the dig, stays mid on the tank in section, goes hero on the name, and ends on the home view with the lid and grass back on top.","hold":true},"sentences":[{"role":"hook","text":"If you dig a pit for your toilet pipe, you have a septic tank."},{"role":"problem","text":"But it fills with raw sewage that spills onto the lawn."},{"role":"fix1","text":"So you build a concrete tank, often around 1,000 gallons, and solids sink."},{"role":"problem2","text":"But now fats, oil and grease float to the top as scum."},{"role":"fix2","text":"So a T-shaped pipe below the scum lets only clear water out."},{"role":"problem3","text":"But now that pipe dumps it in one spot, and the lawn floods."},{"role":"fix3","text":"So holed pipes in gravel spread it, and the soil soaks it up."},{"role":"name","text":"This is a septic tank."},{"role":"fact","text":"Sludge still builds, so it is pumped every 3 to 5 years."},{"role":"finish","text":"Add a riser lid and the grass back on top."},{"role":"congrats","text":"Congratulations, you have built a septic tank."}]}