,"d":1.2},{"lib":"water_rush","at":{"s":"hook","w":"water"},"d":1.6},{"lib":"motor_hum","at":{"s":"fix1","w":"pump"},"d":1.5},{"lib":"water_rush","at":{"s":"fix2","w":"back"},"d":1.5},{"lib":"motor_hum","at":{"s":"fix4","w":"pump"},"d":1.5}],"chimes":[{"s":"fact","w":"4.57"},{"s":"name"},{"s":"congrats"}]},"codeShots":true,"why":"A backyard fish pond dug into the lawn in a park setting, with the cut open so we see the water, the fish and the pipes running through the soil beside it. The camera opens close on the dug hole filling with water. It then follows the chain: green water, a pump and settling tank, ammonia that slips past, the biofilter bed on the return pipe, an oxygen shortage, an air pump, and shade. Counters on a post beside the pond show ammonia and oxygen changing.","hold":true,"beats":[{"s":"hook","shows":{"p":"dig","does":"dig the hole, water fills it, goldfish swim"},"do":[{"p":"dig","v":"dig","o":-0.504},{"p":"pondWater","v":"flood","w":"water","d":2},{"p":"fishA","v":"show","w":"goldfish"}],"shots":[{"focus":["dig"],"width":0.68},{"at":{"s":"hook","w":"goldfish"},"focus":["pondWater","dig"],"width":0.68}]},{"s":"problem","shows":{"p":"pondWater","does":"water turns green"},"state":{"text":"GREEN WATER","w":"green"},"do":[{"p":"pondWater","v":"dirty","w":"green"}],"shots":[{"focus":["pondWater","dig"],"width":0.68}]},{"s":"stakes","shows":{"p":"ammUp","does":"ammonia gauge climbs into red"},"state":{"text":"TOXIC","w":"burns"},"do":[{"p":"ammUp","v":"show","w":"ammonia"},{"p":"ammUp","v":"count","w":"ammonia","o":0.3,"d":2.4}],"shots":[{"focus":["pondWater","ammUp","dig"],"width":0.68}]},{"s":"fix1","shows":{"p":"pipe1","does":"pipe grows from the pond, dirty water is pulled out"},"do":[{"p":"pump","v":"show","w":"pump"},{"p":"pipe1","v":"grow","w":"pipe","d":1},{"p":"flowA","v":"show","w":"pull"}],"shots":[{"focus":["pump","pipe1","pondWater","dig"],"width":0.68}]},{"s":"fix2","shows":{"p":"settle","does":"tank fills, sludge sinks, scum floats, water clears"},"do":[{"p":"settle","v":"show","w":"tank"},{"p":"settle","v":"fill","w":"tank","o":0.4},{"p":"settle","v":"sink","w":"sink"},{"p":"settle","v":"float","w":"floats"},{"p":"settle","v":"clear","w":"floats","o":1},{"p":"pipeRet","v":"grow","w":"back","d":3}],"shots":[{"focus":["settle","dig"],"width":0.68}]},{"s":"problem2","shows":{"p":"flowRet","does":"dots carry the ammonia back along the return pipe"},"state":{"text":"STILL TOXIC","w":"carries"},"do":[{"p":"flowRet","v":"show","w":"carries"}],"shots":[{"focus":["pipeRet","pondWater","flowRet","dig"],"width":0.68}]},{"s":"fix3","shows":{"p":"bio","does":"gravel bed grows over the return pipe and gets wet"},"do":[{"p":"bio","v":"grow","w":"gravel","d":1.3},{"p":"bio","v":"wet","w":"bacteria"}],"shots":[{"focus":["bio","dig"],"width":0.68}]},{"s":"name","shows":{"p":"bioOutline","does":"outline traces the gravel bed"},"do":[{"p":"bioOutline","v":"show","w":"biofilter"}],"shots":[{"hero":true,"focus":["bio","bioOutline","dig"],"width":0.68}]},{"s":"how","shows":{"p":"ammDown","does":"ammonia gauge falls to zero, the pond turns clear"},"do":[{"p":"nitro","v":"show"},{"p":"nitro","v":"hide","w":"Water"},{"p":"ammUp","v":"hide","w":"Water"},{"p":"ammDown","v":"show","w":"eat"},{"p":"ammDown","v":"count","w":"eat","o":0.3,"d":2.5},{"p":"pondWater","v":"clean","w":"clear"}],"shots":[{"focus":["bio","ammDown","pondWater","dig"],"width":0.68}]},{"s":"fact","shows":{"p":"airArrows","does":"white arrows pull oxygen from the pond down toward the gravel"},"do":[{"p":"airArrows","v":"show","w":"oxygen"}],"shots":[{"focus":["bio","pondWater","airArrows","dig"],"width":0.68}]},{"s":"problem3","shows":{"p":"oxy","does":"oxygen gauge drops and fish crowd the surface"},"state":{"text":"LOW OXYGEN","w":"gasping"},"do":[{"p":"airArrows","v":"hide","w":"But"},{"p":"ammDown","v":"hide","w":"But"},{"p":"oxy","v":"show","w":"hot"},{"p":"oxy","v":"count","w":"less","d":2.5},{"p":"fishTop","v":"show","w":"crowd"}],"shots":[{"focus":["pondWater","oxy","dig"],"width":0.68}]},{"s":"fix4","shows":{"p":"bubbles","does":"air pump blows bubbles up through the water, oxygen gauge rises"},"do":[{"p":"airPump","v":"show","w":"pump"},{"p":"airHose","v":"grow","w":"blows","d":1},{"p":"bubbles","v":"show","w":"bubbles"},{"p":"oxy","v":"hide","w":"bubbles"},{"p":"oxy2","v":"show","w":"bubbles","o":0.1},{"p":"oxy2","v":"count","w":"water","d":2}],"shots":[{"focus":["airPump","pondWater","bubbles","dig"],"width":0.68}]},{"s":"fix5","shows":{"p":"trees","does":"young trees pop in behind the pond to shade it"},"do":[{"p":"trees","v":"show","w":"trees"}],"shots":[{"focus":["pondWater","trees","dig"],"width":0.68}]},{"s":"finish","shows":{"p":"rocks","does":"rocks ring the pond edge and lily pads float on the water"},"do":[{"p":"mem2","v":"show"},{"p":"mem2","v":"count","d":2.5},{"p":"mem2","v":"hide","w":"Add"},{"p":"rocks","v":"show","w":"rocks"},{"p":"lily","v":"show","w":"lily","o":-0.7}],"shots":[{"focus":["dig","rocks","lily"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","stakes","fix1","fix2","problem2","fix3","name","how","fact","problem3","fix4","fix5","finish","congrats"]},"sentences":[{"role":"hook","text":"If you dig a hole, fill it with water and add goldfish, you have a fish pond."},{"role":"problem","text":"But the fish make waste that feeds algae, so the clear water turns green."},{"role":"stakes","text":"The waste turns into ammonia, and above about 0.02 mg per liter it can harm the fish's gills."},{"role":"fix1","text":"So you add a pump and a pipe to pull the dirty water out of the pond."},{"role":"fix2","text":"A settling tank lets sludge sink, scum floats on top, and clearer water goes back to the pond."},{"role":"problem2","text":"But ammonia is dissolved, so the clear-looking water carries it straight back into the pond."},{"role":"fix3","text":"So you add a bed of gravel on the return pipe, giving bacteria a place to live."},{"role":"name","text":"This is a biofilter."},{"role":"how","text":"Water flows through the gravel, the bacteria eat the ammonia, the gauge falls to zero and the pond turns clear."},{"role":"fact","text":"Nitrifying one gram of ammonia nitrogen into nitrate uses about 4.57 grams of oxygen from the water."},{"role":"problem3","text":"But on a hot day, warm water holds less oxygen, so the bacteria and fish compete and the fish crowd the surface."},{"role":"fix4","text":"So you add an air pump that blows bubbles up through the water, and the oxygen climbs back."},{"role":"fix5","text":"Then you plant young trees behind the pond to shade it, so the water stays cool."},{"role":"finish","text":"Add rocks round the edge and lily pads on the water."},{"role":"congrats","text":"Congratulations, you have built a fish pond."}]}