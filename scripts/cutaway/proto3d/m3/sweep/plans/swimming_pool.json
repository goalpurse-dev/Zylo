,"d":1.3}],"shots":[{"focus":["filter","dig"],"width":0.68}]},{"s":"name","shows":{"p":"poolOutline","does":"outline traces the pool"},"do":[{"p":"poolOutline","v":"show","w":"swimming"}],"shots":[{"hero":true,"focus":["poolWater","poolOutline","dig"],"width":0.68}]},{"s":"name2","shows":{"p":"loopOutline","does":"outline traces the pump and filter"},"do":[{"p":"poolOutline","v":"hide","w":"pump"},{"p":"loopOutline","v":"show","w":"circulation"}],"shots":[{"hero":true,"focus":["pump","filter","loopOutline","dig"],"width":0.68}]},{"s":"how","shows":{"p":"suctionFlow","does":"water runs out, through the filter, and back"},"do":[{"p":"loopOutline","v":"hide","w":"pulls"},{"p":"suctionFlow","v":"show","w":"pulls"},{"p":"loopArrows","v":"show","w":"pulls"},{"p":"linkFlow","v":"show","w":"strains"},{"p":"returnFlow","v":"show","w":"clean"}],"shots":[{"focus":["suction","pump","filter","returnPipe","suctionFlow","dig"],"width":0.68}]},{"s":"fact","shows":{"p":"swirl","does":"the whole pool's water drifts toward the drain"},"do":[{"p":"swirl","v":"show","w":"volume"}],"shots":[{"focus":["poolWater","pump","swirl","dig"],"width":0.68}]},{"s":"factProof","shows":{"p":"counter","does":"hours counter ticks from 0 to 8"},"do":[{"p":"stand","v":"show","w":"hours"},{"p":"counter","v":"show","w":"hours"},{"p":"counter","v":"count","w":"hours","o":0.2,"d":3}],"shots":[{"focus":["pump","counter","dig"],"width":0.68}]},{"s":"problem2","shows":{"p":"poolWater","does":"water turns green"},"state":{"text":"ALGAE","w":"alive"},"do":[{"p":"counter","v":"hide","w":"But"},{"p":"swirl","v":"hide","w":"But"},{"p":"poolWater","v":"dirty","w":"green"}],"shots":[{"focus":["poolWater","dig"],"width":0.68}]},{"s":"problem3","shows":{"p":"leaves","does":"storm rain and mud lumps fall into the green water"},"state":{"text":"MURKY","w":"storm"},"do":[{"p":"light","v":"storm","w":"storm"},{"p":"rain","v":"start","w":"storm"},{"p":"leaves","v":"fall","w":"leaves"}],"shots":[{"focus":["poolWater","leaves","dig"],"width":0.68}]},{"s":"fix5","shows":{"p":"poolWater","does":"chlorine feeder pops in, water clears"},"do":[{"p":"rain","v":"stop","w":"So"},{"p":"light","v":"clear","w":"So"},{"p":"leaves","v":"hide","w":"So"},{"p":"feeder","v":"show","w":"chlorine"},{"p":"poolWater","v":"clean","w":"clears"}],"shots":[{"focus":["poolWater","feeder","dig"],"width":0.68}]},{"s":"finish","shows":{"p":"fence","does":"fence, bushes and young trees pop in around the pool"},"do":[{"p":"redArrows","v":"show"},{"p":"blueArrows","v":"show"},{"p":"redArrows","v":"hide","w":"Add"},{"p":"blueArrows","v":"hide","w":"Add"},{"p":"fence","v":"show","w":"fence"},{"p":"bushes","v":"show","w":"bushes"},{"p":"trees","v":"show","w":"trees","o":-0.7}],"shots":[{"focus":["dig","fence","bushes","trees"],"width":0.85}]},{"s":"congrats","shows":{"p":"poolWater","does":"calm clear pool with the loop running"},"do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","flood","stakes","fix1","fix2","fix3","fix4","name","name2","how","fact","factProof","problem2","problem3","fix5","finish","congrats"],"why":"A yard scene with the pool pit dug into the cut ground in section. A concrete shell goes in, then water, and a pump, pipes and a filter tank run along the face beside the pit. The camera opens close on the hole, shows the soaking, slumping walls and the shell and water going in, then pulls out to follow the water loop through pump and filter, ending on the calm home view with a fence and trees.","hold":true},"sentences":[{"role":"hook","text":"If you dig a hole in the yard and fill it with water, you have a pool."},{"role":"problem","text":"But the water soaks into the soil and leaks away."},{"role":"flood","text":"Within an hour, the hole is empty bare mud."},{"role":"stakes","text":"But now the wet walls slump in, since a cubic yard of soil can weigh about 3,000 pounds."},{"role":"fix1","text":"So you pour a concrete floor and walls to hold back the water and soil."},{"role":"fix2","text":"So you fill the shell with 20,000 gallons, which weigh around 83 tons."},{"role":"fix3","text":"But now the water goes stale, so a pipe from the bottom carries it to a pump."},{"role":"fix4","text":"Then a filter tank catches the dirt, and a second pipe sends clean water back."},{"role":"name","text":"This is a swimming pool."},{"role":"name2","text":"The pump, filter and pipes together are the circulation system."},{"role":"how","text":"The pump pulls water from the bottom, the filter strains out dirt, and clean water flows back."},{"role":"fact","text":"A typical pump pushes the pool's whole volume through the filter about once every 8 hours."},{"role":"factProof","text":"The clock ticks through 8 hours, and many pools run 8 to 10 hours a day."},{"role":"problem2","text":"But now the filter cannot stop living algae, so in the sun the water turns green."},{"role":"problem3","text":"Then a storm blows leaves and mud in, and the water gets murkier."},{"role":"fix5","text":"So you add chlorine, and the water clears."},{"role":"finish","text":"Add a fence, bushes and young trees around the pool."},{"role":"congrats","text":"Congratulations, you have built a swimming pool."}]}