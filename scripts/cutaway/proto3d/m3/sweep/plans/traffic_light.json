:[11.549999999999999,1.9,-4.199999999999999]},"width":0.9,"zone":"center","view":"high"}]},{"s":"problem3","shows":{"p":"trafficC","does":"the second car rear-ends the first at the sudden red"},"state":{"text":"CRASH!","w":"slams"},"do":[{"p":"loopLine","v":"hide","w":"But"},{"p":"tl","v":"stopPulse","w":"But"},{"p":"tl","v":"green","w":"But"},{"p":"trafficC","v":"pile","d":2},{"p":"tl","v":"red","w":"instant"},{"p":"trafficC","v":"bump","w":"slams"}],"shots":[{"box":{"min":[2.9,0.12,-13.8],"max":[11.049999999999999,5.42,-2.4000000000000004]},"width":0.9,"zone":"center"}]},{"s":"fix3","shows":{"p":"tl","does":"the yellow lamp lights and the dent is fixed"},"do":[{"p":"tl","v":"yellow","w":"yellow"},{"p":"trafficC","v":"unbump","w":"drivers"},{"p":"trafficC","v":"go","w":"stop","o":0.3}],"shots":[{"focus":["tl"],"width":0.7}]},{"s":"fix4","shows":{"p":"tl","does":"at night the signal blinks red"},"do":[{"p":"light","v":"night","w":"night"},{"p":"tl","v":"flash","w":"flash"}],"shots":[{"focus":["tl"],"width":0.7}]},{"s":"myth","shows":{"p":"scale","does":"a scale reading climbs to 1500 like the loop weighs the car"},"do":[{"p":"light","v":"day","w":"And"},{"p":"tl","v":"stopFlash","w":"And"},{"p":"tl","v":"red","w":"And"},{"p":"scale","v":"show","w":"scale"},{"p":"scale","v":"count","w":"weighs","o":0.2,"d":2}],"shots":[{"focus":["scale","tl"],"width":0.8}]},{"s":"mythFact","shows":{"p":"tl","does":"a car rolls onto the loop, its field rings and the lamp turns green"},"do":[{"p":"scale","v":"hide","w":"It"},{"p":"probe","v":"arrive","w":"metal"},{"p":"tl","v":"pulse","w":"field"},{"p":"tl","v":"green","w":"green"},{"p":"probe","v":"leave","w":"green","o":0.4}],"shots":[{"focus":["tl","probe"],"width":0.8}]},{"s":"finish","shows":{"p":"crosswalk","does":"crosswalk stripes, a stop line and a street sign appear while the light cycles"},"do":[{"p":"tl","v":"stopPulse","w":"Add"},{"p":"tl","v":"cycle","w":"Add"},{"p":"crosswalk","v":"show","w":"crosswalk"},{"p":"stopLine","v":"show","w":"line"},{"p":"streetSign","v":"show","w":"sign","o":-0.7}],"shots":[{"focus":["tl","crosswalk","stopLine","streetSign"],"width":0.85}]},{"s":"congrats","shows":{"p":"passer","does":"a taxi drives through on the working light"},"do":[{"p":"passer","v":"arrive","w":"Congratulations"},{"p":"passer","v":"leave","w":"light","o":0.3}],"shots":[]}],"audio":{"cards":[{"text":"60 SECONDS","at":{"s":"fact","w":"60"},"d":1.8},{"text":"2 SECONDS","at":{"s":"factProof","w":"2"},"d":1.6},{"text":"3 TO 6 SECONDS","at":{"s":"fix3","w":"3"},"d":1.8}],"sfx":[{"lib":"motor_hum","at":{"s":"fix1","w":"box"},"d":1.4},{"lib":"motor_hum","at":{"s":"how","w":"timer"},"d":1.2},{"lib":"motor_hum","at":{"s":"fix2","w":"feels"},"d":1.2}],"chimes":[{"s":"name"},{"s":"fact","w":"60"},{"s":"name2"},{"s":"fix3","w":"3"},{"s":"congrats"}]},"codeShots":true,"why":"A traffic light on the corner of a one-road street with its gray controller box beside it. The camera opens close on the lone red lamp, follows the queue at the red, the box and its timer, the lone car at night, the wire loop and the rear-end crash that the yellow lamp fixes, then ends on the finished crossing with the light cycling.","hold":true},"sentences":[{"role":"hook","text":"If you hang one red lamp over the road, you have a traffic light."},{"role":"problem","text":"But it never changes, so cars pile up nose to tail at the red."},{"role":"stakes","text":"Drivers wait one minute, then two, then five, and nobody moves."},{"role":"fix1","text":"So you add a green lamp and a gray box that switches them."},{"role":"name","text":"This is a signal controller."},{"role":"how","text":"Inside, a timer switches the lamps from green to red on a fixed clock."},{"role":"fact","text":"One full cycle at a busy corner lasts about 60 to 120 seconds."},{"role":"factProof","text":"Each green lets one car cross the line about every 2 seconds."},{"role":"problem2","text":"But the box runs on a clock, so at midnight one car waits at an empty red."},{"role":"fix2","text":"So you cut a loop of wire into the road that feels a car's metal."},{"role":"name2","text":"This is an inductive loop detector."},{"role":"problem3","text":"But now the light flips the instant a car arrives, and the car behind slams into it."},{"role":"fix3","text":"So you add a yellow lamp that gives drivers about 3 to 6 seconds to stop."},{"role":"fix4","text":"And late at night, quiet corners just flash red, so you stop and go."},{"role":"myth","text":"And the loop under the road is not a scale that weighs your car."},{"role":"mythFact","text":"It feels the metal changing its field, and the box turns the lamp green."},{"role":"finish","text":"Add crosswalk stripes, a stop line, and a street sign."},{"role":"congrats","text":"Congratulations, you have built a traffic light."}]}