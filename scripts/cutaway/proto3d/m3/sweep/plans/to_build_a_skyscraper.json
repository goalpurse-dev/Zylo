ck"],"width":0.94}]},{"s":"fix3","shows":{"p":"tower","does":"a steel weight appears near the top and swings against the sway"},"do":[{"p":"wind","v":"hide","w":"So"},{"p":"tower","v":"damp","w":"weight"},{"p":"tower","v":"tune","w":"swings"},{"p":"tower","v":"swayBack","w":"swings","o":0.2}],"shots":[{"focus":["tower","stack"],"width":0.94}]},{"s":"finish","shows":{"p":"tower","does":"glass walls and a blinking spire go on, entrance steps appear"},"do":[{"p":"frameLoad","v":"show"},{"p":"tower","v":"brick"},{"p":"tower","v":"brickBack"},{"p":"frameLoad","v":"hide","w":"Add"},{"p":"tower","v":"glass","w":"glass"},{"p":"tower","v":"spire","w":"spire"},{"p":"tower","v":"beacon","w":"spire","o":0.5},{"p":"steps","v":"show","w":"steps","o":-0.7}],"shots":[{"focus":["stack","steps"],"width":0.85}]},{"s":"congrats","shows":{"p":"tower","does":"finished tower stands calm"},"do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","fix1","fix2","name","how","problem2","fix3","finish","congrats"]},"sentences":[{"role":"hook","text":"If you stack floors on a sidewalk, you have a pile of blocks."},{"role":"problem","text":"But all that weight sinks into the soft ground and the stack leans."},{"role":"fix1","text":"So you dig a pit and drive 192 concrete piles down to solid rock."},{"role":"fix2","text":"But the piles stand apart, so you pour a thick concrete mat across their tops that spreads the load over of them."},{"role":"name","text":"This is a piled raft foundation."},{"role":"how","text":"Steel columns rise floor by floor, and the piles pass the weight down to the rock."},{"role":"problem2","text":"But now the wind pushes the tall, slim tower and it sways from side to side."},{"role":"fix3","text":"So you hang a giant steel weight near the top that swings against the sway and calms it."},{"role":"finish","text":"Add glass walls, a spire and entrance steps."},{"role":"congrats","text":"Congratulations, you have built a skyscraper."}]}