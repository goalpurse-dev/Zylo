","w":"snaps"}],"shots":[{"focus":["bridge","car","dig"],"width":0.68}]},{"s":"fix1","shows":{"p":"girders","does":"steel girders appear under the plank, plank lifts back"},"do":[{"p":"girders","v":"show","w":"girders"},{"p":"bridge","v":"snapBack","w":"girders","o":0.3}],"shots":[{"focus":["girders","dig"],"width":0.68}]},{"s":"fix2","shows":{"p":"pier","does":"pier pops in under the middle"},"do":[{"p":"pier","v":"show","w":"pier"}],"shots":[{"focus":["pier","girders","dig"],"width":0.68}]},{"s":"name","shows":{"p":"bridgeOutline","does":"outline traces deck and pier"},"do":[{"p":"bridgeOutline","v":"show","w":"beam"}],"shots":[{"hero":true,"focus":["bridge","pier","bridgeOutline","dig"],"width":0.68}]},{"s":"how","shows":{"p":"car","does":"car drives across, weight arrows press down on deck and pier"},"do":[{"p":"bridgeOutline","v":"hide"},{"p":"car","v":"leave","w":"car"},{"p":"weight","v":"show","w":"weight"}],"shots":[{"focus":["bridge","pier","car","dig"],"width":0.68}]},{"s":"problem2","shows":{"p":"river","does":"flood fills the gap, current hits the pier, crack grows"},"state":{"text":"FLOODED","w":"flood"},"do":[{"p":"weight","v":"hide","w":"But"},{"p":"light","v":"storm","w":"But"},{"p":"rain","v":"start","w":"But"},{"p":"lawn","v":"wet","w":"But"},{"p":"river","v":"flood","w":"flood","d":2},{"p":"current","v":"start","w":"river"},{"p":"pierCrack","v":"grow","w":"scours"},{"p":"wetBand","v":"wet","w":"scours"}],"shots":[{"focus":["river","dig"],"width":0.68}]},{"s":"fix3","shows":{"p":"jacket","does":"concrete wraps the pier, rocks pile at its foot, flood drains"},"do":[{"p":"rain","v":"stop","w":"So"},{"p":"light","v":"clear","w":"So"},{"p":"lawn","v":"dry","w":"So"},{"p":"current","v":"stop","w":"So"},{"p":"jacket","v":"grow","w":"concrete","d":1.2},{"p":"riprap","v":"show","w":"rocks"},{"p":"river","v":"drain","w":"rocks","d":2.5},{"p":"wetBand","v":"dry","w":"rocks"}],"shots":[{"focus":["jacket","dig"],"width":0.68}]},{"s":"myth","shows":{"p":"bridge","does":"red clamp locks the deck end, then falls away"},"do":[{"p":"bridge","v":"lock","w":"And"},{"p":"bridge","v":"lockBack","w":"locked","o":0.3}],"shots":[{"focus":["bridge","dig"],"width":0.68}]},{"s":"mythFact","shows":{"p":"bridge","does":"heat arrows rise, deck slides longer"},"do":[{"p":"heat","v":"show","w":"summer"},{"p":"bridge","v":"grow","w":"grows"}],"shots":[{"focus":["bridge","dig"],"width":0.68}]},{"s":"finish","shows":{"p":"bridge","does":"rails and centre line appear, lamp pops, young trees pop in"},"do":[{"p":"heat","v":"hide","w":"Add"},{"p":"bridge","v":"growBack","w":"Add"},{"p":"bridge","v":"rails","w":"rails"},{"p":"bridge","v":"line","w":"line"},{"p":"lamp","v":"show","w":"lamp"},{"p":"youngTrees","v":"show","w":"trees","o":-0.7}],"shots":[{"focus":["dig","lamp","youngTrees"],"width":0.85}]},{"s":"congrats","shows":{"p":"car2","does":"car drives across and off the finished bridge"},"do":[{"p":"car2","v":"arrive","w":"Congratulations"},{"p":"car2","v":"leave","w":"bridge"}],"shots":[{"focus":"home"}]}],"audio":{"cards":[{"text":"6 CENTIMETRES","at":{"s":"mythFact","w":"6"},"d":1.6}],"sfx":[{"lib":"dirt","at":{"s":"hook","w":"dig","o":0.05},"d":1.2},{"lib":"water_rush","at":{"s":"problem2","w":"flood"},"d":1.6},{"lib":"dirt","at":{"s":"fix3","w":"rocks"},"d":1}],"chimes":[{"s":"name"},{"s":"mythFact","w":"6"},{"s":"congrats"}],"rain":{"from":{"s":"problem2","w":"But"},"to":{"s":"fix3","w":"So","o":0.5},"underDb":24}},"codeShots":true,"why":"A beam bridge built in the cut ground: a plank over a dug gap snaps under a car, then girders, a pier, a flood and a concrete jacket with rocks make the bridge. The camera starts close on the dig and the plank, then frames the whole span for the name and how beats, and the pier foot for the flood. The finish now adds rails, a centre line, a lamp and young trees, and the car only drives across in the congrats beat.","hold":true},"sentences":[{"role":"hook","text":"If you dig a gap and lay a plank across, you have a bridge."},{"role":"problem","text":"But a car rolls onto the plank and it snaps."},{"role":"fix1","text":"So you add steel girders under the plank."},{"role":"fix2","text":"But the girders span a long gap, so you add a pier to hold up the middle."},{"role":"name","text":"This is a beam bridge."},{"role":"how","text":"As the car crosses, its weight squeezes the top of the beam and stretches the bottom."},{"role":"problem2","text":"But now a flood fills the river, and the current scours the foot of the pier until it cracks."},{"role":"fix3","text":"So you wrap the pier in concrete and pile rocks round its foot."},{"role":"myth","text":"And a bridge is not locked rigid."},{"role":"mythFact","text":"In summer, a 100 metre steel deck grows about 6 centimetres, so it slides."},{"role":"finish","text":"Add rails, a centre line, a lamp and young trees."},{"role":"congrats","text":"Congratulations, you have built a bridge."}]}