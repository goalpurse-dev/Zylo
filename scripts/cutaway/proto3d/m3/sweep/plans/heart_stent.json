ery","v":"pushUpBack","w":"back"},{"p":"artery","v":"pushDownBack","w":"back"},{"p":"artery","v":"bloodBack","w":"stops"}],"shots":[{"focus":["artery"],"width":0.94}]},{"s":"fix1","shows":{"p":"artery","does":"a metal mesh tube appears round the balloon, opens the artery and stays when the balloon goes"},"do":[{"p":"artery","v":"inflate","w":"mesh"},{"p":"artery","v":"pushUp","w":"mesh"},{"p":"artery","v":"pushDown","w":"mesh"},{"p":"artery","v":"mesh","w":"mesh","o":0.2},{"p":"artery","v":"balloonBack","w":"open"},{"p":"artery","v":"blood","w":"open"}],"shots":[{"focus":["artery.stent"],"width":0.55,"zone":"center"}]},{"s":"problem2","shows":{"p":"artery","does":"pink scar tissue grows inside the mesh and the blood stops"},"state":{"text":"NARROW AGAIN","w":"scar"},"do":[{"p":"artery","v":"scar","w":"scar"},{"p":"artery","v":"bloodBack","w":"scar","o":0.4}],"shots":[{"focus":["artery.stent"],"width":0.55,"zone":"center"}]},{"s":"fix2","shows":{"p":"artery","does":"the mesh glows green with its drug coating and the pink scar goes away"},"do":[{"p":"artery","v":"coat","w":"drug"},{"p":"artery","v":"scarBack","w":"scar"},{"p":"artery","v":"blood","w":"scar","o":0.3}],"shots":[{"focus":["artery.stent"],"width":0.55,"zone":"center"}]},{"s":"name","shows":{"p":"arteryOutline","does":"a glowing outline traces the mesh"},"do":[{"p":"arteryOutline","v":"show","w":"stent"}],"shots":[{"hero":true,"focus":["artery.stent","arteryOutline"],"width":0.5}]},{"s":"how","shows":{"p":"artery","does":"red blood dots run through the open mesh"},"do":[{"p":"arteryOutline","v":"hide"},{"p":"artery","v":"coatBack"},{"p":"artery","v":"blood","w":"blood"}],"shots":[{"focus":["artery"],"width":0.94}]},{"s":"fact","shows":{"p":"paper","does":"a 1986 newspaper page rises beside the artery"},"do":[{"p":"paper","v":"show","w":"1986","o":-0.5}],"shots":[{"at":{"s":"fact"},"focus":["paper"],"width":0.75,"zone":"center"}]},{"s":"finish","shows":{"p":"artery","does":"a thin guide wire and a blue catheter slide in from the left"},"do":[{"p":"paper","v":"hide","w":"Add"},{"p":"artery","v":"wire","w":"wire","autoW":{"w0":"wire","o0":-0.7}}],"shots":[{"focus":["artery"],"width":0.85}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"audio":{"cards":[{"text":"1986","at":{"s":"fact","w":"1986"},"d":1.4}],"sfx":[{"lib":"water_rush","at":{"s":"hook","w":"artery"},"d":1.2},{"lib":"drip","at":{"s":"problem","w":"stops"},"d":1},{"lib":"water_rush","at":{"s":"how","w":"blood"},"d":1.2}],"chimes":[{"s":"name"},{"s":"fact","w":"1986"},{"s":"congrats"}]},"codeShots":true,"why":"The kit has no setting inside the body, so the story is told on a big cut-open artery model on stands in a room: red blood dots run through it, yellow plaque narrows it, a balloon pushes the plaque back, a metal mesh stent holds it open, scar tissue grows and a drug coating stops it. The camera stays close on the artery model and ends on the whole room.","hold":true},"sentences":[{"role":"hook","text":"If you blow up a tiny balloon inside a clogged artery, you have angioplasty."},{"role":"problem","text":"But when the balloon goes down, the plaque springs back and the blood stops."},{"role":"fix1","text":"So you wrap the balloon in a metal mesh that holds the artery open."},{"role":"problem2","text":"But now scar tissue grows through the mesh and blocks it again."},{"role":"fix2","text":"So you coat the mesh with a drug that keeps the scar from growing back."},{"role":"name","text":"This is a stent."},{"role":"how","text":"Now blood flows freely through the open mesh to the heart muscle."},{"role":"fact","text":"The first stent went into a human heart artery in 1986, in Toulouse, France."},{"role":"finish","text":"Add a thin wire and a tube that carry it in from the wrist or groin."},{"role":"congrats","text":"Congratulations, you have built a stent."}]}