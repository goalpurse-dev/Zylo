0.7,1.55,-1.9],"dir":[0,1],"travel":0.3,"phase":0.6}],"opts":{"scale":0.5,"color":"#ff8a2a"}}},{"id":"clutchOutline","kind":"outline","params":{"points":[[-1.455,0.525,-2.51],[-1.455,1.642,-2.51],[-0.445,1.642,-2.51],[-0.445,0.525,-2.51]],"opts":{"r":0.045,"closed":true,"over":true},"of":"saw.drum"}},{"id":"springOutline","kind":"outline","params":{"points":[[-0.68,1.03,-1.8],[-0.76,1.22,-1.8],[-0.95,1.3,-1.8],[-1.14,1.22,-1.8],[-1.22,1.03,-1.8],[-1.14,0.84,-1.8],[-0.95,0.76,-1.8],[-0.76,0.84,-1.8]],"opts":{"r":0.02,"closed":true}}},{"id":"sign","kind":"sign","params":{"at":[2.9400000000000004,0.08,-6.2],"rotY":-0.2,"scale":1}}],"cues":[],"audio":{"cards":[],"sfx":[{"lib":"motor_hum","at":{"s":"problem","w":"engine"},"d":1.6},{"lib":"motor_hum","at":{"s":"how","w":"grab"},"d":1.4},{"lib":"motor_hum","at":{"s":"problem2","w":"kicks"},"d":1.2},{"lib":"motor_hum","at":{"s":"problem3","w":"grind"},"d":1.4}],"chimes":[{"s":"name"},{"s":"congrats"}]},"codeShots":true,"why":"A chainsaw clutch explained on a garage workbench stand: a cutaway saw shows the shaft, drum, shoes, ring spring, brake band and trigger working. The camera holds mid and close shots on the clutch and ends on the finished saw. The only change is the clutch cover: it now hangs on posts that reach back to the saw body, so it no longer floats.","hold":true,"beats":[{"s":"hook","shows":{"p":"saw","does":"chain bolts onto the engine shaft"},"do":[{"p":"saw","v":"show"},{"p":"saw","v":"sprocket","w":"bolt"},{"p":"saw","v":"chainOn","w":"chain"}],"shots":[{"focus":["saw"],"width":0.94}]},{"s":"problem","shows":{"p":"saw","does":"engine spins and the chain whirls"},"state":{"text":"NEVER STOPS","w":"never"},"do":[{"p":"saw","v":"crankSpin","w":"engine"},{"p":"saw","v":"drumSpin","w":"engine"},{"p":"saw","v":"run","w":"engine"}],"shots":[{"focus":["saw"],"width":0.94}]},{"s":"fix1","shows":{"p":"saw","does":"loose drum cup appears, drum and chain stop while the shaft spins"},"do":[{"p":"post","v":"show"},{"p":"post","v":"slice"},{"p":"post","v":"hide","w":"So"},{"p":"saw","v":"cup","w":"drum"},{"p":"saw","v":"drumSpinBack","w":"free"},{"p":"saw","v":"runBack","w":"free"}],"shots":[{"focus":["saw.drum"],"width":0.55}]},{"s":"fix2","shows":{"p":"saw","does":"three shoes appear, fling out and spin the drum and chain"},"do":[{"p":"saw","v":"shoesOn","w":"shoes"},{"p":"saw","v":"fling","w":"fling"},{"p":"saw","v":"drumSpin","w":"grab"},{"p":"saw","v":"run","w":"grab"}],"shots":[{"focus":["saw.drum"],"width":0.55}]},{"s":"fix3","shows":{"p":"saw","does":"ring spring appears and pulls the shoes back, drum stops"},"do":[{"p":"saw","v":"springOn","w":"spring"},{"p":"saw","v":"flingBack","w":"pulls"},{"p":"saw","v":"drumSpinBack","w":"pulls"},{"p":"saw","v":"runBack","w":"pulls"}],"shots":[{"focus":["saw.drum"],"width":0.55}]},{"s":"name","shows":{"p":"clutchOutline","does":"glowing outline round the clutch"},"do":[{"p":"clutchOutline","v":"show","w":"centrifugal"}],"shots":[{"hero":true,"focus":["saw.drum","clutchOutline"],"width":0.5}]},{"s":"how","shows":{"p":"saw","does":"shoes fling out, grab the drum, chain runs"},"do":[{"p":"clutchOutline","v":"hide"},{"p":"springOutline","v":"show"},{"p":"springOutline","v":"hide"},{"p":"outArrows","v":"show","w":"fling"},{"p":"saw","v":"fling","w":"fling"},{"p":"saw","v":"drumSpin","w":"grab"},{"p":"saw","v":"run","w":"grab"}],"shots":[{"focus":["saw"],"width":0.94}]},{"s":"problem2","shows":{"p":"saw","does":"bar kicks up with the chain still running"},"state":{"text":"KICKBACK","w":"kicks"},"do":[{"p":"saw","v":"flingBack"},{"p":"saw","v":"drumSpinBack"},{"p":"saw","v":"runBack"},{"p":"saw","v":"poleOn"},{"p":"rpm","v":"show"},{"p":"rpm","v":"count","d":2},{"p":"saw","v":"fling"},{"p":"saw","v":"drumSpin"},{"p":"saw","v":"run"},{"p":"rpm","v":"hide","w":"But"},{"p":"saw","v":"kick","w":"kicks"}],"shots":[{"focus":["saw"],"width":0.94}]},{"s":"fix4","shows":{"p":"saw","does":"hand guard knocks forward, brake band clamps the drum, chain stops"},"do":[{"p":"saw","v":"kickBack","w":"So"},{"p":"saw","v":"bandOn","w":"band"},{"p":"saw","v":"guardOn","w":"guard"},{"p":"saw","v":"knock","w":"knocks"},{"p":"saw","v":"drumSpinBack","w":"stops"},{"p":"saw","v":"runBack","w":"stops"}],"shots":[{"focus":["saw"],"width":0.94}]},{"s":"problem3","shows":{"p":"saw","does":"shoes fling out, grind the stopped drum and glow red"},"state":{"text":"OVERHEATING","w":"glow"},"do":[{"p":"rpmHigh","v":"show","w":"engine"},{"p":"saw","v":"fling","w":"grind"},{"p":"saw","v":"hot","w":"glow"},{"p":"heatArrows","v":"show","w":"glow"}],"shots":[{"focus":["saw.drum","rpmHigh"],"width":0.8}]},{"s":"fix5","shows":{"p":"rpmHigh","does":"trigger squeezed then released, rpm falls to idle, shoes pull back, glow goes"},"do":[{"p":"saw","v":"handleOn","w":"trigger"},{"p":"saw","v":"squeeze","w":"trigger","o":0.3},{"p":"saw","v":"squeezeBack","w":"idle"},{"p":"rpmHigh","v":"count","w":"idle","d":2.2},{"p":"saw","v":"flingBack","w":"idle"},{"p":"saw","v":"hotBack","w":"idle"},{"p":"heatArrows","v":"hide","w":"idle"}],"shots":[{"focus":["saw","rpmHigh"],"width":0.94}]},{"s":"congrats","do":[],"shots":[{"focus":"home"}]}],"roles":["hook","problem","fix1","fix2","fix3","name","how","problem2","fix4","problem3","fix5","congrats"]},"sentences":[{"role":"hook","text":"If you bolt a chain straight onto the engine shaft, you have a saw that only spins."},{"role":"problem","text":"But the engine never stops turning, so the chain whirls around the bar every second the saw is on."},{"role":"fix1","text":"So you hang the chain on a loose drum, and the engine spins free inside it, though now the chain won't move."},{"role":"fix2","text":"So you bolt heavy shoes to the shaft, and when it spins fast they fling out and grab the drum."},{"role":"fix3","text":"But now the shoes never let go, so you add a ring spring that pulls them back in, letting go of the drum."},{"role":"name","text":"This is a centrifugal clutch."},{"role":"how","text":"At idle the spring wins, but as the engine revs, the shoes fling out, grab the drum and the chain runs."},{"role":"problem2","text":"But if the bar tip catches, the saw kicks up toward your face with the chain racing."},{"role":"fix4","text":"So you add a brake band round the drum, and when the hand guard knocks forward, the chain stops in about 0.12 seconds on average."},{"role":"problem3","text":"But with the brake on and the engine screaming, the shoes grind against the stopped drum and glow red hot."},{"role":"fix5","text":"So you add a spring-loaded trigger that drops the engine to idle when you let go, and the shoes pull in and cool."},{"role":"congrats","text":"Congratulations, you have built a chainsaw."}]}