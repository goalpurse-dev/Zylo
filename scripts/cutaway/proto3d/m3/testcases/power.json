 "sentences": [
  {
   "role": "hook",
   "text": "If you pack uranium so tightly it gets hot, you have a reactor."
  },
  {
   "role": "problem",
   "text": "But heat alone is useless, so its steam spins a turbine."
  },
  {
   "role": "fix1",
   "text": "So you add a cooling tower to turn the steam back to water."
  },
  {
   "role": "name",
   "text": "This is a power plant, and its lines carry the power away."
  },
  {
   "role": "congrats",
   "text": "Congratulations, you have built a power plant."
  }
 ]
