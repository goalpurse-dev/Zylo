# Blocky Stories, local stack only. Copy to .env.blocky.local (git-ignored; a
# commit that contains it is refused) and fill in. NEVER put a production key
# here: make separate keys with a low spending limit. Guide: docs/blocky-local.md

# ── Provider keys: separate LOCAL keys, each with a low spending limit ──
# Runware: scene pictures, clips, location plates.
RUNWARE_API_KEY=
# Anthropic: the story writer and the script editor.
ANTHROPIC_API_KEY=
# OpenAI: the picture check, the clip word check, small rewrites, the upload text.
OPENAI_API_KEY=

# ── Spending switch: "off" = no paid call can be made (the default here) ──
# Remove the line, or set it to "on", only for a paid run you decided on.
BLOCKY_PAID_CALLS=off

# ── Filled in by "node scripts/blocky/local.mjs start" ──
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
BLOCKY_LOCAL_SERVICE_ROLE_KEY=
BLOCKY_WORKER_SECRET=change-me
# The address the browser and the providers use for stored pictures and clips.
# http://127.0.0.1:54321 is enough to look around and write stories. For a run
# that makes pictures from an edit, or clips, a provider has to fetch a stored
# picture: put a tunnel's https address here (docs/blocky-local.md, step 6).
BLOCKY_PUBLIC_URL=http://127.0.0.1:54321
# Runware can't call a computer back without a tunnel: results are picked up by the sweep.
BLOCKY_WEBHOOKS=off
# The script editor is on unless this is "off".
# BLOCKY_SCRIPT_REVIEW=off
